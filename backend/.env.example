NODE_ENV=development
PORT=3000

# Global route prefix. Leave empty to serve at root (default for the Flutter client).
API_PREFIX=

# PostgreSQL connection string (Docker compose provisions a matching DB locally).
DATABASE_URL="postgresql://reem_user:12345678@localhost:5432/reem_db?schema=public"

# JWT — generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Rate limiting (global) — window in seconds, max requests per window
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Comma-separated OAuth client/service IDs accepted for native social sign-in.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
