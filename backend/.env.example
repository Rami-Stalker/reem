# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database — SQLite (zero setup, great for local dev)
DATABASE_URL="mongodb+srv://ramiStalker:Reem123456@reemcluster.c4tgs69.mongodb.net/reem?retryWrites=true&w=majority"
# PostgreSQL (production / Docker) — uncomment and use docker compose:
# DATABASE_URL="postgresql://reem:reem_secret@localhost:5432/reem_db?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30
