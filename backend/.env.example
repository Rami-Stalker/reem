NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Global route prefix. Leave empty to serve at root (default for the Flutter client).
API_PREFIX=

# PostgreSQL connection string.
#
# Production database: PostgreSQL hosted by Supabase (project `reem`). Supabase
# is only the database host (and, with MEDIA_DRIVER=supabase, the file store);
# the app talks to this API, never to Supabase. Use the TRANSACTION pooler
# (Dashboard → Connect → Transaction pooler, port 6543) with:
#   pgbouncer=true            required on 6543 — Prisma must not prepare statements
#   sslmode=require           TLS
#   sslcert=./certs/supabase-root-2021.crt  (resolved against prisma/)
#   sslaccept=strict          verify the server against that CA
# The boot refuses a Supabase URL missing pgbouncer=true or sslmode=require.
# URL-encode the password. Never commit the real value.
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require&sslcert=./certs/supabase-root-2021.crt&sslaccept=strict"
#
# Local development database (Docker compose provisions a matching one):
DATABASE_URL="postgresql://reem_user:12345678@localhost:5432/reem_db?schema=public"

# npm test connects to TEST_DATABASE_URL, and refuses any non-local database
# (scripts/test-database-guard.js) — integration specs write fixtures.
TEST_DATABASE_URL="postgresql://reem_user:12345678@localhost:5432/reem_db?schema=public"

# Interactive transaction budget (checkout, ledger). Prisma's defaults suit an
# API in the database's region; raise them for an instance far from it.
# DATABASE_TRANSACTION_TIMEOUT_MS=5000
# DATABASE_TRANSACTION_MAX_WAIT_MS=2000

# Migrations against the Supabase database: `prisma migrate deploy` cannot run
# over the transaction pooler, so use `npm run db:pooled:status` (read-only)
# and `npm run db:pooled:deploy` — see scripts/migrate-pooled.mjs.

# Scheduled jobs (escrow release, OTP outbox, order expiry, media sweep, …).
# Each run takes a lease in scheduled_job_states, so several instances never
# run the same job twice. `false` keeps the timers off on this instance — for a
# laptop pointed at a shared database, or API instances beside a worker.
# See docs/SCHEDULED_JOBS.md.
SCHEDULER_ENABLED=true

# Enables POST /internal/jobs/:name/run (header X-Reem-Job-Secret) for an
# external scheduler or an operator. Unset: the route does not exist. 32+ chars.
# JOBS_TRIGGER_SECRET=

# ─── Supabase (server-side only) ──────────────────────────────────────────────
# Needed only with MEDIA_DRIVER=supabase. The SECRET key bypasses Row Level
# Security: it lives in this environment and is never shipped in the app,
# logged, or accepted from a client. Refused at boot if the publishable key is
# put here by mistake.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_MEDIA_PUBLIC_BUCKET=reem-media-public
# SUPABASE_MEDIA_PRIVATE_BUCKET=reem-media-private

# JWT — generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for dev)
#
# Refused at boot when NODE_ENV=production: `*` reflects whatever Origin the
# caller sent and the API pairs that with credentials, so production must name
# its origins — e.g. CORS_ORIGINS=https://reem.shop,https://admin.reem.shop
CORS_ORIGINS=*

# Rate limiting (global) — window in seconds, max requests per window
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120


# Auth keyring — four DISTINCT secrets. Sharing one makes rotation an outage.
OTP_PEPPER=change-me-otp-pepper-min-32-characters-long
GUEST_TOKEN_PEPPER=change-me-guest-pepper-min-32-characters-long

# Transitional deadline for the retired `?token=` on the chat socket.
#
# The chat WebSocket takes its bearer token from a header: `Authorization` for
# anything that is not a browser, and the `reem.auth.bearer` subprotocol pair
# for one that is. It used to accept `?token=` — the whole access token in a
# query string, which every proxy on the way writes into its access log.
#
# Leave EMPTY. Set it only to roll the client forward without stranding the
# installs still on the old handshake, as an ISO instant no more than 30 days
# out; the server refuses to boot past that. The fallback closes itself at the
# instant named, with no restart. Watch for the warning it logs — when that
# stops appearing, the rollout is done and this can be cleared early.
#
# WS_QUERY_TOKEN_UNTIL=2026-09-15T00:00:00Z
WS_QUERY_TOKEN_UNTIL=

# Set behind a reverse proxy so rate limiting sees the real client IP.
# Accepts express' trust-proxy values: false, true, a hop count, or a subnet.
TRUST_PROXY=false

# One JSON object per log line, each carrying the `requestId` that also goes
# back to the client in `request_id` and the `X-Request-Id` header. Set this in
# production: with one process serving every customer, a coloured sentence with
# nothing tying it to a request turns "her order failed at about four" into
# reading a wall of interleaved lines. Leave it unset in development, where the
# readable format is the useful one.
# LOG_FORMAT=json

# Routes that REFUSE a request arriving without an `Idempotency-Key`.
# Comma-separated `METHOD /route/pattern` — the pattern, not the URL with ids.
#
# Leave empty until the app update that sends keys has reached your installs.
# The protection already works whenever a client sends one, and the app does
# for checkout; demanding one earlier refuses every older build, so a woman on
# last month's version could not buy anything. Once the update has propagated,
# turning this on closes the double-tap gap for good rather than depending on
# the client to remember.
# IDEMPOTENCY_REQUIRED_ROUTES=POST /orders/checkout

OTP_DELIVERY_KEY=change-me-otp-delivery-key-min-32-characters

TOTP_ENC_KEY=change-me-totp-encryption-key-min-32-chars

# ── OTP delivery ──────────────────────────────────────────────────────
# Production refuses to boot unless at least one provider below is complete
# (SMS URL+key, WhatsApp id+token, or voice URL+key): otherwise nobody can sign in.
#
# Temporary stand-in for a test environment with no provider: fixed LOGIN codes
# for named accounts that already exist (nothing is sent to them). Requires a
# deadline at most 30 days out; while it is open production may boot without a
# provider, but only these accounts can sign in. Never commit real codes.
# OTP_TEST_ACCOUNTS=+963900000000:123456,+963900000001:654321
# OTP_TEST_ACCOUNTS_UNTIL=2026-10-01T00:00:00Z
# WhatsApp Cloud (via a BSP — Meta cannot usually be paid from Syria directly).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=reem_auth_code
WHATSAPP_TEMPLATE_LOCALE=ar
WHATSAPP_COST_MICROS=5000

# Local Syrian SMS aggregator. Body template placeholders: {{sender}} {{to}} {{text}}
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SMS_SENDER_ID=REEM
SMS_COST_MICROS=30000

# Voice fallback — most expensive, last in the chain.
VOICE_OTP_URL=
VOICE_OTP_KEY=
VOICE_COST_MICROS=120000

# ── Exchange rate feed (Q47/Q50 — «تلقائياً من موقع الليرة اليوم») ──────────
# Off by default: a published rate reprices every USD-listed product, so the
# feed only runs when someone turns it on and says where it reads from.
FX_SYNC_ENABLED=false
# JSON endpoint returning the current SYP-per-USD rate.
#
# IMPORTANT: the common free feeds (open.er-api.com, exchangerate-api.com)
# quote Syria's OFFICIAL rate (~2,000 SYP/USD). The parallel market this
# platform prices against is several times higher. Publishing an official rate
# would reprice the entire USD-listed catalogue by that multiple — the move
# guard below refuses it, which is why nothing is set here by default.
# Point this at a parallel-market source before enabling.
#
#   Verified working shape (official rate — NOT suitable for pricing):
#   FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
#   FX_SOURCE_PATH=rates.SYP
FX_SOURCE_URL=
# Dotted path to the rate inside the response, e.g. `usd.ask`.
FX_SOURCE_PATH=rate
FX_SOURCE_NAME=sp-today
# Largest move published without a human, in basis points (2500 = 25%).
# A mangled scrape is likelier than a jump this size; past it the rate is
# logged and dropped for review.
FX_MAX_MOVE_BPS=2500
# Sanity bounds on SYP per USD — a value outside these is a parse error.
FX_MIN_RATE=500
FX_MAX_RATE=100000

# Stand-in for the SMS aggregator, until one is contracted.
# Serves outstanding one-time codes with NO session at:
#   http://localhost:3000/auth/dev/inbox.html
# Sign-in is a code now, so without this nobody can enter a fresh environment —
# not even the first admin, who cannot read the ops console without signing in.
# Refused at boot when NODE_ENV=production. Remove once a provider is live.
OTP_DEV_INBOX_ENABLED=false

# ─── Media uploads ────────────────────────────────────────────────────────────
# `local` stores bytes on the API host's disk; `supabase` stores them in the
# Supabase Storage buckets (public bucket served by Supabase's CDN, private
# bucket streamed only through GET /media/:id/file after authorisation).
# Production uses `supabase` — that is where every existing upload lives.
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=storage/media
# Leave unset with MEDIA_DRIVER=supabase (it defaults to the bucket's public path).
MEDIA_PUBLIC_BASE_URL=/media/files
# Production refuses MEDIA_DRIVER=local: a container disk is wiped on deploy.
# Set true only when MEDIA_LOCAL_ROOT is a persistent volume.
# MEDIA_LOCAL_PERSISTENT=true
# Required in production; the app refuses to boot without it — except on Render,
# where RENDER_EXTERNAL_URL (set by Render) is used when this is empty. Left empty in
# development, media URLs are built from the origin each request arrived on,
# which is the only value that is correct from localhost, the Android emulator
# and a physical phone at the same time.
MEDIA_PUBLIC_ORIGIN=
MEDIA_MAX_IMAGE_BYTES=12582912
MEDIA_MAX_VIDEO_BYTES=67108864
MEDIA_MAX_DOCUMENT_BYTES=16777216
MEDIA_MAX_AUDIO_BYTES=25165824
MEDIA_ORPHAN_TTL_HOURS=24
MEDIA_DAILY_UPLOADS_PER_USER=300

# ─── Reem AI Stylist ──────────────────────────────────────────────────────────
# The conversational shopping assistant. It works with everything below unset:
# the understanding layer has a complete rules implementation and the products
# come out of the catalogue by SQL either way. Configuring a provider buys a
# better reading of an unusual sentence and warmer phrasing — never a product,
# a price or a stock level, because the model is not on that path at all.
#
# `none` (default) or `anthropic`. Named without a key, the stylist logs the
# misconfiguration and keeps serving the deterministic path.
AI_STYLIST_PROVIDER=none
AI_STYLIST_API_KEY=
AI_STYLIST_BASE_URL=https://api.anthropic.com
AI_STYLIST_MODEL=claude-sonnet-5
# She is waiting on a chat bubble, so the ceiling is what a person will sit
# through. Past it the turn is abandoned and the rules answer instead.
AI_STYLIST_TIMEOUT_MS=8000
AI_STYLIST_MAX_TOKENS=1024
# Extraction and phrasing are separate switches: a misread brief shows the
# wrong goods, whereas phrasing only rewrites a sentence around goods that were
# already chosen from the database.
AI_STYLIST_COMPOSE_REPLIES=true

# ── Reem Trend Engine ────────────────────────────────────────────────────
#
# Market analysis, trend scoring, forecasting and Arabic insights. Everything
# below can stay unset: the engine is arithmetic over rows, its narration has a
# complete Arabic template implementation, and a language model only ever
# rephrases a finished sentence.
#
# The scheduler is OFF by default, and deliberately. The nightly run reads the
# whole order history and rewrites ten tables; that is not something a
# `nest start --watch` on a laptop should begin doing at 2am because the machine
# happened to be awake. Turn it on where the data is real.
TRENDS_SCHEDULER_ENABLED=false

# ── Marketplace intelligence ─────────────────────────────────────────────────
#
# Two switches, and the split is deliberate.
#
# The first runs the nightly *reads*: listing and boutique ranking, customer
# profiles (how likely she is to buy, how likely she is to leave, what she is
# worth, when she is awake), and the trust sweeps over reviews, customers and
# sellers. None of that is visible to anybody until a person opens a screen, so
# the only cost of leaving it off is that every ranking is stale.
INTELLIGENCE_SCHEDULER_ENABLED=false

# The second lets the platform *send* — abandoned-basket reminders and
# win-back messages. It is separate on purpose: turning the intelligence on
# must never quietly turn on outbound marketing to several hundred women, and
# there is no way to un-send a push notification.
#
# The frequency cap still applies whatever this is set to: one marketing
# message a day, three a week, nothing between 22:00 and 09:00 in Damascus,
# and never to a woman who turned push off. Order updates are never capped.
#
# Turn this on only after somebody has read what the messages actually say.
REENGAGEMENT_SCHEDULER_ENABLED=false
# How many days each nightly run re-reads. Facts settle late — an order placed
# on Monday is cancelled on Wednesday and returned on Friday — so the last few
# days are recomputed until they stop changing.
TRENDS_LOOKBACK_DAYS=3
# How long a cart may sit untouched before it counts as abandoned.
TRENDS_CART_ABANDON_HOURS=6
#
# The narrator. With no provider, insights are phrased by Arabic templates that
# are a complete implementation rather than a placeholder — so a missing key is
# the deterministic mode, and it is the one the tests run in. A model is handed
# a finished finding and its already-rounded figures, and any reply that quotes
# a number the finding did not carry is discarded in favour of the template.
TREND_LLM_PROVIDER=none
TREND_LLM_API_KEY=
TREND_LLM_BASE_URL=https://api.anthropic.com
TREND_LLM_MODEL=claude-sonnet-5
# Generous, because nobody is waiting: this runs inside the nightly job.
TREND_LLM_TIMEOUT_MS=20000
TREND_LLM_MAX_TOKENS=4096
# Findings per request, so one night's feed has one voice.
TREND_LLM_BATCH_SIZE=8

# ── Reem Visual Shopping — البحث بالصورة ────────────────────────────────
#
# The catalogue has to be *described* before a photograph can be matched
# against it: every product image is decoded once into a perceptual descriptor,
# and a listing with no descriptor cannot be found by picture. Until that has
# happened for at least one product, the screen honestly says it is not ready
# yet — which is what "إعدادات البحث بالصورة ليست جاهزة" was: not a broken
# feature, an empty index.
#
# The sweep is hourly and off by default, because on a laptop it is a
# background job nobody asked for. Turn it on for an environment that should
# stay searchable on its own:
VISUAL_SEARCH_INDEXER_ENABLED=false
# Products per pass. The first run over a fresh catalogue spreads across
# several passes rather than pinning a core.
VISUAL_SEARCH_INDEXER_BATCH=120
# Images described per product.
VISUAL_SEARCH_IMAGES_PER_PRODUCT=3
# How long to wait on a catalogue image that lives on someone else's host. The
# demo dataset's photographs come from a placeholder service that redirects and
# is often slow, so this is generous.
VISUAL_SEARCH_FETCH_TIMEOUT_MS=15000
#
# To index right now, without waiting for the sweep:
#     npm run visual:index

# ─────────────────────────── Delivery companies ────────────────────────────
#
# Reem does not run drivers. A parcel is handed to a delivery company, and the
# company reports back over a signed webhook. Which companies exist, which
# governorates each covers and which one wins is *database* configuration an
# operations admin edits at `/admin/delivery/providers` — nothing about a
# carrier lives in code.
#
# What lives here is only the secrets. A carrier's row names the variables it
# needs (`credential_env_keys`, e.g. {"apiKey":"ACME_API_KEY"}) and the server
# reads them from the environment; the database never stores a key, the admin
# API never returns one, and the Flutter app never sees one — it reads the
# delivery status and tracking number off Reem's own API.
#
# Adding a real carrier, once its documentation is in hand:
#   1. put its credentials here, under names of your choosing;
#   2. POST /admin/delivery/providers with `adapter: "http_generic"`, its
#      base URL and paths in `config`, and those variable names in
#      `credential_env_keys`;
#   3. give the carrier the callback URL the response prints
#      (`/webhooks/delivery/<code>`) and its signing secret;
#   4. enable it. Dispatch refuses to enable a carrier it cannot reach.
#
# The sandbox carrier used by `node scripts/delivery-e2e.mjs`:
ACME_API_KEY=sandbox-api-key
ACME_WEBHOOK_SECRET=sandbox-webhook-secret

# ───────────────────────── Push notifications (FCM) ─────────────────────────
#
# The transport that makes a notification arrive on a phone whose owner has
# *closed the app*. Without it, everything the platform has to say is written
# into the in-app inbox and read only by whoever was already looking — which
# is precisely the wrong audience for "your order is out for delivery".
#
# Unset by default, and that is not an oversight: with no provider the
# delivery worker records each push as SKIPPED rather than pretending it was
# sent. The API logs one warning at boot saying so.
#
# Note what is NOT here: a server key. The legacy `Authorization: key=`
# credential and the `/fcm/send` endpoint it went to were decommissioned by
# Google in June 2024 and answer 404 to everything, so a deployment could be
# configured perfectly and still never ring a phone.
#
# Getting the credential:
#   1. Firebase console → Project settings → Service accounts
#   2. "Generate new private key" → downloads a JSON file
#   3. paste it whole into FCM_SERVICE_ACCOUNT_JSON below (raw JSON on one
#      line, or base64 of the file — both are accepted, because a dashboard's
#      environment editor and a shell disagree about newlines)
#
# The same Firebase project must own the Android app (google-services.json)
# and the iOS app, and an APNs key has to be uploaded under
# Cloud Messaging → Apple app configuration, or iOS pushes are accepted and
# never delivered.
#FCM_SERVICE_ACCOUNT_JSON=
#
# Or the three fields separately. FCM_PRIVATE_KEY may contain literal \n.
#FCM_PROJECT_ID=
#FCM_CLIENT_EMAIL=
#FCM_PRIVATE_KEY=
#
# How many times a transient failure (a 503, a rate limit) is retried before
# the delivery gives up, over a rising backoff from 30s. Low on purpose:
# everything Reem pushes has a shelf life in hours.
PUSH_MAX_ATTEMPTS=5
#
# The fallback transport: any provider that speaks JSON over HTTP. Kept for
# the handsets sold here without Google Play Services — a Huawei phone has no
# FCM at all, and that is not a small share of this market. FCM wins when both
# are set. Placeholders: {{token}} {{title}} {{body}} {{deep_link}}
#PUSH_ENDPOINT=
#PUSH_AUTH_HEADER=
#PUSH_BODY_TEMPLATE=
