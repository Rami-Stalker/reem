NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Global route prefix. Leave empty to serve at root (default for the Flutter client).
API_PREFIX=

# PostgreSQL connection string (Docker compose provisions a matching DB locally).
DATABASE_URL="postgresql://reem_user:12345678@localhost:5432/reem_db?schema=public"

# JWT — generate strong secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Rate limiting (global) — window in seconds, max requests per window
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120


# Auth keyring — four DISTINCT secrets. Sharing one makes rotation an outage.
OTP_PEPPER=change-me-otp-pepper-min-32-characters-long
GUEST_TOKEN_PEPPER=change-me-guest-pepper-min-32-characters-long

# Transitional deadline for the retired `?token=` on the chat socket.
#
# The chat WebSocket takes its bearer token from a header: `Authorization` for
# anything that is not a browser, and the `reem.auth.bearer` subprotocol pair
# for one that is. It used to accept `?token=` — the whole access token in a
# query string, which every proxy on the way writes into its access log.
#
# Leave EMPTY. Set it only to roll the client forward without stranding the
# installs still on the old handshake, as an ISO instant no more than 30 days
# out; the server refuses to boot past that. The fallback closes itself at the
# instant named, with no restart. Watch for the warning it logs — when that
# stops appearing, the rollout is done and this can be cleared early.
#
# WS_QUERY_TOKEN_UNTIL=2026-09-15T00:00:00Z
WS_QUERY_TOKEN_UNTIL=

# Set behind a reverse proxy so rate limiting sees the real client IP.
# Accepts express' trust-proxy values: false, true, a hop count, or a subnet.
TRUST_PROXY=false

OTP_DELIVERY_KEY=change-me-otp-delivery-key-min-32-characters

TOTP_ENC_KEY=change-me-totp-encryption-key-min-32-chars

# ── OTP delivery ──────────────────────────────────────────────────────
# WhatsApp Cloud (via a BSP — Meta cannot usually be paid from Syria directly).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=reem_auth_code
WHATSAPP_TEMPLATE_LOCALE=ar
WHATSAPP_COST_MICROS=5000

# Local Syrian SMS aggregator. Body template placeholders: {{sender}} {{to}} {{text}}
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SMS_SENDER_ID=REEM
SMS_COST_MICROS=30000

# Voice fallback — most expensive, last in the chain.
VOICE_OTP_URL=
VOICE_OTP_KEY=
VOICE_COST_MICROS=120000

# ── Exchange rate feed (Q47/Q50 — «تلقائياً من موقع الليرة اليوم») ──────────
# Off by default: a published rate reprices every USD-listed product, so the
# feed only runs when someone turns it on and says where it reads from.
FX_SYNC_ENABLED=false
# JSON endpoint returning the current SYP-per-USD rate.
#
# IMPORTANT: the common free feeds (open.er-api.com, exchangerate-api.com)
# quote Syria's OFFICIAL rate (~2,000 SYP/USD). The parallel market this
# platform prices against is several times higher. Publishing an official rate
# would reprice the entire USD-listed catalogue by that multiple — the move
# guard below refuses it, which is why nothing is set here by default.
# Point this at a parallel-market source before enabling.
#
#   Verified working shape (official rate — NOT suitable for pricing):
#   FX_SOURCE_URL=https://open.er-api.com/v6/latest/USD
#   FX_SOURCE_PATH=rates.SYP
FX_SOURCE_URL=
# Dotted path to the rate inside the response, e.g. `usd.ask`.
FX_SOURCE_PATH=rate
FX_SOURCE_NAME=sp-today
# Largest move published without a human, in basis points (2500 = 25%).
# A mangled scrape is likelier than a jump this size; past it the rate is
# logged and dropped for review.
FX_MAX_MOVE_BPS=2500
# Sanity bounds on SYP per USD — a value outside these is a parse error.
FX_MIN_RATE=500
FX_MAX_RATE=100000

# Stand-in for the SMS aggregator, until one is contracted.
# Serves outstanding one-time codes with NO session at:
#   http://localhost:3000/auth/dev/inbox.html
# Sign-in is a code now, so without this nobody can enter a fresh environment —
# not even the first admin, who cannot read the ops console without signing in.
# Refused at boot when NODE_ENV=production. Remove once a provider is live.
OTP_DEV_INBOX_ENABLED=false

# ─── Media uploads ────────────────────────────────────────────────────────────
# Bytes are stored on the API host's disk for the closed beta. Swapping in a
# bucket means adding a driver class, not changing these names.
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=storage/media
MEDIA_PUBLIC_BASE_URL=/media/files
# Required in production; the app refuses to boot without it. Left empty in
# development, media URLs are built from the origin each request arrived on,
# which is the only value that is correct from localhost, the Android emulator
# and a physical phone at the same time.
MEDIA_PUBLIC_ORIGIN=
MEDIA_MAX_IMAGE_BYTES=12582912
MEDIA_MAX_VIDEO_BYTES=67108864
MEDIA_MAX_DOCUMENT_BYTES=16777216
MEDIA_MAX_AUDIO_BYTES=25165824
MEDIA_ORPHAN_TTL_HOURS=24
MEDIA_DAILY_UPLOADS_PER_USER=300

# ─── Reem AI Stylist ──────────────────────────────────────────────────────────
# The conversational shopping assistant. It works with everything below unset:
# the understanding layer has a complete rules implementation and the products
# come out of the catalogue by SQL either way. Configuring a provider buys a
# better reading of an unusual sentence and warmer phrasing — never a product,
# a price or a stock level, because the model is not on that path at all.
#
# `none` (default) or `anthropic`. Named without a key, the stylist logs the
# misconfiguration and keeps serving the deterministic path.
AI_STYLIST_PROVIDER=none
AI_STYLIST_API_KEY=
AI_STYLIST_BASE_URL=https://api.anthropic.com
AI_STYLIST_MODEL=claude-sonnet-5
# She is waiting on a chat bubble, so the ceiling is what a person will sit
# through. Past it the turn is abandoned and the rules answer instead.
AI_STYLIST_TIMEOUT_MS=8000
AI_STYLIST_MAX_TOKENS=1024
# Extraction and phrasing are separate switches: a misread brief shows the
# wrong goods, whereas phrasing only rewrites a sentence around goods that were
# already chosen from the database.
AI_STYLIST_COMPOSE_REPLIES=true

# ── Reem Trend Engine ────────────────────────────────────────────────────
#
# Market analysis, trend scoring, forecasting and Arabic insights. Everything
# below can stay unset: the engine is arithmetic over rows, its narration has a
# complete Arabic template implementation, and a language model only ever
# rephrases a finished sentence.
#
# The scheduler is OFF by default, and deliberately. The nightly run reads the
# whole order history and rewrites ten tables; that is not something a
# `nest start --watch` on a laptop should begin doing at 2am because the machine
# happened to be awake. Turn it on where the data is real.
TRENDS_SCHEDULER_ENABLED=false
# How many days each nightly run re-reads. Facts settle late — an order placed
# on Monday is cancelled on Wednesday and returned on Friday — so the last few
# days are recomputed until they stop changing.
TRENDS_LOOKBACK_DAYS=3
# How long a cart may sit untouched before it counts as abandoned.
TRENDS_CART_ABANDON_HOURS=6
#
# The narrator. With no provider, insights are phrased by Arabic templates that
# are a complete implementation rather than a placeholder — so a missing key is
# the deterministic mode, and it is the one the tests run in. A model is handed
# a finished finding and its already-rounded figures, and any reply that quotes
# a number the finding did not carry is discarded in favour of the template.
TREND_LLM_PROVIDER=none
TREND_LLM_API_KEY=
TREND_LLM_BASE_URL=https://api.anthropic.com
TREND_LLM_MODEL=claude-sonnet-5
# Generous, because nobody is waiting: this runs inside the nightly job.
TREND_LLM_TIMEOUT_MS=20000
TREND_LLM_MAX_TOKENS=4096
# Findings per request, so one night's feed has one voice.
TREND_LLM_BATCH_SIZE=8

# ── Reem Visual Shopping — البحث بالصورة ────────────────────────────────
#
# The catalogue has to be *described* before a photograph can be matched
# against it: every product image is decoded once into a perceptual descriptor,
# and a listing with no descriptor cannot be found by picture. Until that has
# happened for at least one product, the screen honestly says it is not ready
# yet — which is what "إعدادات البحث بالصورة ليست جاهزة" was: not a broken
# feature, an empty index.
#
# The sweep is hourly and off by default, because on a laptop it is a
# background job nobody asked for. Turn it on for an environment that should
# stay searchable on its own:
VISUAL_SEARCH_INDEXER_ENABLED=false
# Products per pass. The first run over a fresh catalogue spreads across
# several passes rather than pinning a core.
VISUAL_SEARCH_INDEXER_BATCH=120
# Images described per product.
VISUAL_SEARCH_IMAGES_PER_PRODUCT=3
# How long to wait on a catalogue image that lives on someone else's host. The
# demo dataset's photographs come from a placeholder service that redirects and
# is often slow, so this is generous.
VISUAL_SEARCH_FETCH_TIMEOUT_MS=15000
#
# To index right now, without waiting for the sweep:
#     npm run visual:index
