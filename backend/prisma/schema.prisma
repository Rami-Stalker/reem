// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                         String             @id @default(uuid()) @db.Uuid
  name                       String
  username                   String             @unique
  email                      String?            @unique
  phone                      String?            @unique
  /// Optional, and off by default (owner decision 1). Null is the normal
  /// state of a Ohara account: the code on her SIM is the credential, and a
  /// password is a convenience she may add for a device we already know.
  passwordHash               String?            @map("password_hash")
  /// When she opted in. Distinguishes "never had one" from "had one, removed
  /// it", which matters when reading a takeover timeline.
  passwordSetAt              DateTime?          @map("password_set_at")
  bio                        String?
  imageUrl                   String?            @map("image_url")
  location                   String?
  /// **The public badge, and nothing else.**
  ///
  /// This used to be set to `true` by the OTP exchange — so every account that
  /// had ever received a code wore «موثّقة» beside her name, which made the
  /// badge mean "has a phone" and therefore mean nothing. It is now written in
  /// exactly one place: an `AccountVerification` a human reviewed and granted.
  /// «هل أثبتت رقمها» is [phoneVerifiedAt], which is a different question and
  /// has its own column.
  isVerified                 Boolean            @default(false) @map("is_verified")

  /// When the badge was granted, so it can be revoked and re-read later.
  verifiedAt                 DateTime?          @map("verified_at")
  phoneVerifiedAt            DateTime?          @map("phone_verified_at")
  emailVerifiedAt            DateTime?          @map("email_verified_at")
  role                       UserRole           @default(CUSTOMER)
  /// Q43/Q138 P1 — self-declared at signup; there is no technical gender check.
  declaredFemale             Boolean            @default(true) @map("declared_female")
  /// When she made that attestation. Null means the account predates the
  /// declaration being collected at all — which is every row written before
  /// registration started asking for it, and is why the boolean alone could
