// ───────────────────────────── Settings ─────────────────────────────

/// A saved delivery address.
///
/// Shaped like the country it ships to, not like a Western postal form. The
/// fields are exactly the ones checkout needs (Q57/Q65) — a governorate to
/// price the journey, a district and a rural flag for Q53's two tiers, and a
/// landmark, because a Damascus address is given by what it is near far more
/// often than by a street number. The old `street/country/postal_code` shape
/// could not fill a single checkout field, which is why the address book sat
/// unused while every customer retyped her address on every order.
model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// «المنزل», «العمل» — hers to name.
  label String @default("المنزل")

  /// Who receives it, which is not always the woman who ordered it.
  recipientName  String @map("recipient_name")
  recipientPhone String @map("recipient_phone")

  governorate String
  district    String?
  city        String
  addressLine String  @map("address_line")
  landmark    String?

  /// Where she dropped the pin on the map, when she used it. Optional: the
  /// typed fields are still the address, and the pin is what takes a courier
  /// the last fifty metres an address line here rarely covers.
  latitude  Float?
  longitude Float?

  /// Q53 P2 — city centre and rural are priced separately.
  isRural Boolean @default(false) @map("is_rural")

  /// Q55 — «اتصلي قبل الوصول»، kept with the address so she types it once.
  deliveryInstructions String? @map("delivery_instructions")

  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Where a home appointment is performed. `SetNull` on the appointment side:
  /// deleting an address must not delete a booking she still has.
  appointments Appointment[]

  @@index([userId, isDefault])
  @@map("addresses")
}

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  title           String
  type            CouponType @default(PERCENTAGE)
  currency        Currency   @default(SYP)
  discountPercent Decimal    @default(0) @map("discount_percent") @db.Decimal(5, 2)
  amountOff       Decimal?   @map("amount_off") @db.Decimal(18, 4)
  minOrderAmount  Decimal?   @map("min_order_amount") @db.Decimal(18, 4)

  /// The most a percentage code may ever take off one order.
  ///
  /// A percentage with no ceiling is a discount nobody approved: 15% is a
  /// sensible welcome on a dress and an unbudgeted fortune on a gold set, and
  /// this marketplace sells both. Null means uncapped, which is right for a
  /// fixed-amount code and for a percentage an operator deliberately left
  /// open; every referral coupon sets it.
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(18, 4)

  maxUses         Int?       @map("max_uses")
  usedCount       Int        @default(0) @map("used_count")
  perUserLimit    Int?       @map("per_user_limit")
  // Null = global coupon; set = user-specific.
  userId          String?    @map("user_id") @db.Uuid
  user            User?      @relation("UserCoupons", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime   @map("expires_at")
  isActive        Boolean    @default(true) @map("is_active")
  /// Q49 P2 — who absorbs the discount: whoever created the coupon.
  fundedBySeller  Boolean    @default(false) @map("funded_by_seller")

  // ── What the code may be spent on ─────────────────────────────────────
  //
  // All three null means the whole basket, which is what every coupon was
  // until now — and was the bug. `fundedBySeller` said a seller paid for the
  // discount, but nothing said *which* seller's goods it applied to, so a code
  // one boutique created reduced the commission base of every boutique in the
  // basket. Seller B paid part of seller A's promotion without being told.
  //
  // Scoping is evaluated per line, and the discount is computed on the
  // eligible subtotal alone — never on the basket total — so a 20% code on one
  // dress cannot take 20% off a basket of five.

  /// Only this seller's lines. Set on any seller-funded code.
  sellerId String? @map("seller_id") @db.Uuid
  seller   User?   @relation("SellerCoupons", fields: [sellerId], references: [id], onDelete: Cascade)

  /// Only lines in this category. Matched on the line's own category, not on
  /// ancestry — a category tree walked at checkout is a query per line.
  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Only this product. The narrowest scope there is.
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  redemptions     CouponRedemption[]
  referralRewards ReferralReward[]
  loyaltyRewards  LoyaltyReward[]

  /// Codes handed to the women who promote a boutique. Empty until the
  /// ambassador programme exists; the relation is here so that programme is
  /// a write path rather than a migration of a live table.
  reshares CommerceContentReshare[] @relation("ReshareCoupons")

  @@index([userId])
  // Declared here as well as in `20260909150000_coupon_scope`, which created
  // them in raw SQL. Undeclared, the datamodel and the database disagreed, and
  // the next `migrate dev` would have generated a migration dropping all three
  // — silently turning every scoped-coupon lookup back into a sequential scan.
  @@index([sellerId])
  @@index([categoryId])
  @@index([productId])
  @@map("coupons")
}

