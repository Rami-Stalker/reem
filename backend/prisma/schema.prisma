model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  campaignId        String?                    @map("campaign_id") @db.Uuid
  campaign          NotificationCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  notificationId    String?                    @map("notification_id") @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  /**
   * Whether this message is something she asked for or something the platform
   * wants.
   * The whole basis of frequency capping. An order that has shipped must reach
   * her whatever her recent volume; a third offer this week must not. Without
   * the distinction a cap either throttles the messages she is waiting for or
   * fails to throttle the ones she is not.
   */
  category          NotificationCategory       @default(TRANSACTIONAL)
  status            NotificationDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?                    @map("provider_message_id")
  title             String
  body              String
  payload           Json?
  scheduledAt       DateTime?                  @map("scheduled_at")
  sentAt            DateTime?                  @map("sent_at")
  failedAt          DateTime?                  @map("failed_at")
  failureReason     String?                    @map("failure_reason")
  openedAt          DateTime?                  @map("opened_at")
  clickedAt         DateTime?                  @map("clicked_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  /// How many times this has been handed to a provider.
  ///
  /// A push that fails because Google answered 503 is not a push that should
  /// be abandoned — it is the order-shipped message she is waiting for, and
  /// the outage lasts ninety seconds. But a failure retried for ever is worse
  /// than one dropped: it occupies the worker on every pass and hides the
  /// deliveries behind it. So attempts are counted and the row gives up.
  attempts Int @default(0)

  /// Not before this instant. Written on a transient failure with an
  /// exponential backoff, so a provider having a bad minute is not hammered
  /// by six hundred retries in that same minute.
  nextAttemptAt DateTime? @map("next_attempt_at")

  events NotificationEvent[]

  @@index([userId, status])
  @@index([campaignId])
  @@index([channel, status])
  @@index([scheduledAt, status])
  /// What the delivery worker actually asks for on every pass: queued rows
  /// whose backoff has elapsed.
  @@index([status, nextAttemptAt])
  /// The frequency cap counts this on every marketing send, so it gets its
  /// own index rather than leaning on the user+status one. Ordered
  /// (user, category, sent_at) because that is exactly the shape of the
  /// question: "how much marketing has this woman had lately".
  @@index([userId, category, sentAt])
  @@map("notification_deliveries")
}

