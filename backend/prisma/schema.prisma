/// Support-mediated recovery, for the one case the self-service ladder cannot
/// reach: the SIM is gone.
///
/// Every transition is deliberate friction. `SUBMITTED` -> `UNDER_REVIEW` is a
/// human reading platform-held evidence; `AWAITING_SECOND_APPROVAL` is dual
/// control, because a single support account must never be able to hand an
/// account to anyone; `COOLING_OFF` is the 72 hours during which the real
/// owner — who still holds the number in every scenario but this one — can
/// kill the case from her phone.
enum AccountRecoveryStatus {
  SUBMITTED
  UNDER_REVIEW
