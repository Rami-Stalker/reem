  VERIFIED
  REJECTED
  SUSPENDED
}

enum AiInteractionType {
  RECOMMENDATION_VIEW
  SEARCH_SUGGESTION
  PRODUCT_DESCRIPTION
  TAG_GENERATION
  HOME_FEED
  SIMILAR_PRODUCTS
  SELLER_RECOMMENDATION
  BEHAVIOR_ANALYSIS
}

enum AiGenerationType {
