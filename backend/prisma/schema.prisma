  sellerReply     String?   @map("seller_reply")
  sellerRepliedAt DateTime? @map("seller_replied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  moderationLogs ReviewModerationLog[]

  /// One voice per customer per boutique — see `ProductReview` for why the
  /// order is no longer part of the key.
  @@unique([sellerId, userId])
  @@index([sellerId, status, createdAt])
  @@index([userId, createdAt])
  @@map("seller_reviews")
}

