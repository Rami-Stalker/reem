  APPROVED
  REJECTED
  FLAGGED
}

enum ReviewTargetType {
  PRODUCT
  SELLER
}

enum SellerBadgeType {
  TRUSTED
  TOP_SELLER
  FAST_SHIPPER
  CUSTOMER_LOVED
  VERIFIED_BRAND
}

enum SellerProgramTier {
