  userId            String               @map("user_id") @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              ChatParticipantRole?
  lastReadMessageId String?              @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime?            @map("last_read_at")
  mutedUntil        DateTime?            @map("muted_until")
  archivedAt        DateTime?            @map("archived_at")
  joinedAt          DateTime             @default(now()) @map("joined_at")

  @@unique([chatId, userId])
  @@index([userId, archivedAt])
  @@map("chat_participants")
}

model Message {
  id          String                @id @default(uuid()) @db.Uuid
  chatId      String                @map("chat_id") @db.Uuid
  chat        Chat                  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String                @map("sender_id") @db.Uuid
  sender      User                  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  clientId    String?               @map("client_id")
  kind        MessageKind           @default(TEXT)
  content     String
  metadata    Json?
  status      MessageDeliveryStatus @default(SENT)
  deliveredAt DateTime?             @map("delivered_at")
  readAt      DateTime?             @map("read_at")
  editedAt    DateTime?             @map("edited_at")
  deletedAt   DateTime?             @map("deleted_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  attachments MessageAttachment[]
  receipts    MessageReadReceipt[]

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
  @@index([kind])
  // No index on `content`. A btree entry cannot exceed ~2704 bytes, and this
  // column is unbounded text the API accepts up to 5,000 characters of — at
  // two bytes per Arabic character a long message failed to INSERT at all,
  // with `54000: index row size exceeds btree version 4 maximum`. It could not
  // have served the substring search it looks like it was for either; btree
  // cannot answer `LIKE '%…%'`. Message search wants GIN trigram or a
  // tsvector column, added deliberately.
  @@map("messages")
}

model MessageAttachment {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      MessageKind
  url       String

  /// The upload this points at, when it is one of ours.
  ///
  /// The URL alone cannot answer "may this person open it": chat media is
  /// private, so the reader is whoever is in the conversation, and finding
  /// that from a URL means a suffix match across every attachment ever sent.
  /// This is the indexed answer. Null for anything not uploaded through
  /// `MediaService` — the demo dataset's external links, a future integration.
  ///
  /// `SetNull` rather than cascade: if an asset is ever deleted the message
  /// must survive as a record of what was said, holding a dead link rather
  /// than vanishing from the conversation.
  mediaAssetId String?     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mimeType     String?     @map("mime_type")
  fileName     String?     @map("file_name")
  sizeBytes    Int?        @map("size_bytes")
  width        Int?
  height       Int?
  durationMs   Int?        @map("duration_ms")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([messageId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

model MessageReadReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_read_receipts")
}

