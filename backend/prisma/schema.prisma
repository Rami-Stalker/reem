model PushToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The hash is the dedupe key — the same handset re-registering must update
  /// its row rather than adding another.
  tokenHash String @unique @map("token_hash")

  /// The token itself, which the platform has to keep in order to use it.
  ///
  /// Only the hash was stored before, which made every push unsendable: a
  /// device token is an *address* issued by the push provider, not a secret of
  /// ours, and hashing an address means never being able to write to it.
  token      String   @default("")
  provider   String
  platform   String?
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  /// The handset, as the handset knows itself.
  ///
  /// A push token is not stable: the provider reissues it after a reinstall,
  /// a restore from backup, or a long idle period, and the old one keeps
  /// answering for a while. Without a device identity, a woman who reinstalls
  /// twice accumulates three rows and gets every notification three times —
  /// and the two dead ones are not discovered until a send fails against them.
  /// With it, re-registering retires the handset's previous token.
  deviceId String? @map("device_id")

  /// What she is running, so a delivery problem traceable to one build is
  /// traceable at all. Also what makes it possible to stop pushing a feature
  /// to versions that cannot open it.
  appVersion String? @map("app_version")

  /// Her language, for the day a notification is composed rather than
  /// translated — the body text is written server-side and there is no other
  /// signal here about which language to write it in.
  locale String?

  /// Consecutive transient failures against this address. Reset on success.
  /// A token that has failed repeatedly is retired even when the provider
  /// never said the word UNREGISTERED, which some of them never do.
  failureCount      Int       @default(0) @map("failure_count")
  lastFailureReason String?   @map("last_failure_reason")
  /// When and why it stopped being used — kept rather than deleted, because
  /// "she has no device" and "her device went away on Tuesday" are different
  /// answers to a support question.
  disabledAt        DateTime? @map("disabled_at")

  /// The sign-in that registered this address.
  ///
  /// A push is a message to a signed-in person, so it only goes to a handset
  /// whose session is still live. Signing out, "sign out other devices",
  /// removing a device and an admin cutting her sessions all revoke sessions;
  /// none of them used to touch this table, so a phone she had removed kept
  /// showing her messages on its lock screen. Deleted with the session.
  /// Null on rows registered before this existed; the app re-registers on
  /// every launch, which fills it in.
  sessionId String?  @map("session_id") @db.Uuid
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([deviceId])
  @@index([sessionId])
  @@map("push_tokens")
}

