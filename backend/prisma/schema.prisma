/// Q48 — SYP amounts are rounded before display and charging.
///
/// The client's rule was «الأسعار بالليرة تُقرّب لأقرب ألف», written when the
/// platform priced in the old lira. Syria redenominated by dropping two zeros,
/// so the same real granularity is now the nearest **ten**: 1,000 old = 10
/// new. `NEAREST_1000` stays in the enum because orders placed before the
/// changeover carry it and an order's policy is frozen at creation.
enum RoundingPolicy {
  NONE
  NEAREST_10
  NEAREST_100
  NEAREST_500
  NEAREST_1000
}

