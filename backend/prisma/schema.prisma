/// Which of the two channels this came through.
///
/// Deliberately two, not one with a dropdown. A woman telling us the search is
/// slow and a woman telling us her parcel never came are doing different
/// things: the first is a gift and can wait a week, the second is a failure and
/// cannot. Folding them into one queue means the gifts bury the failures, which
/// is how a feedback form ends up being a place complaints go to die.
enum CustomerFeedbackKind {
  /// «ملاحظات ونصائح» — an idea, a suggestion, something that could be better.
  SUGGESTION
  /// «الشكاوى» — something went wrong and she wants it dealt with.
  COMPLAINT
}

enum CustomerFeedbackStatus {
  NEW
  REVIEWING
  /// Somebody did something about it.
  ACTIONED
  CLOSED
}

/// What a customer told the people who run Ohara.
///
/// Not a support ticket. A ticket is a conversation about *her* problem with
/// *her* order, and `SupportTicket` already models that — it has messages, a
/// thread, an assignee and an SLA. This is the other thing: a note to whoever
/// runs the platform, which may want an answer and often does not, and which
/// the people reading it sort by theme rather than by customer.
model CustomerFeedback {
  id     String  @id @default(uuid()) @db.Uuid
  /// Null once the account is deleted: what she said about the product is
  /// still worth reading, and it stops being about her the moment she leaves.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("CustomerFeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)

  kind   CustomerFeedbackKind
  status CustomerFeedbackStatus @default(NEW)

  /// Where in the app she was talking about — free text from a short list the
  /// client offers, so the console can group without a migration every time
  /// the app grows a screen.
  area String?

  subject String?
  body    String

  /// What she was looking at, when the screen could say. An order number, a
  /// product id: the difference between «التوصيل تأخر» and a complaint
  /// somebody can act on.
  context Json?

  /// Whether she wants to be written back to. A complaint usually does; a
  /// suggestion usually does not, and promising an answer to every note is a
  /// promise this platform would break.
  wantsReply Boolean @default(false) @map("wants_reply")

  /// The operator's note, and who wrote it. Internal — she is answered through
  /// support or a notification, not by reading this.
  handledNote String?   @map("handled_note")
  handledById String?   @map("handled_by_id") @db.Uuid
  handledBy   User?     @relation("CustomerFeedbackHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime? @map("handled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The console's two queues: one per channel, newest first, filtered by
  /// status. One index answers both.
  @@index([kind, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([handledById])
  @@map("customer_feedback")
}

enum AccountVerificationStatus {
  /// Submitted, nobody has picked it up.
  PENDING
  /// An operator has it open.
  UNDER_REVIEW
  /// Sent back with a note: the photograph was unreadable, the name did not
  /// match. Still hers to fix — this is not a refusal.
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
  /// Granted once, withdrawn since. Distinct from `REJECTED`, which never
  /// granted anything: a revoked badge is a decision about an account that
  /// *had* one, and the difference matters when reading a history.
  REVOKED
}

/// What kind of account is asking, which decides what evidence is asked for.
enum AccountVerificationKind {
  /// A woman proving she is who her page says she is.
  PERSONAL
  /// A shop proving the business behind it. Separate from
  /// `SellerVerification`, which is the *permission to sell* — a boutique can
  /// be allowed to trade without its public identity being vouched for, and
  /// the two are reviewed against different evidence.
  BUSINESS
}

/// **Real account verification.** One live claim per account.
///
/// The badge on a name used to be `users.is_verified`, set to `true` by the
/// OTP exchange — so it appeared the moment an account existed, said only
/// "this person received a text message", and appeared identical to the badge
/// a reviewed boutique wore. That is a verification system in the same sense
/// that a drawing of a lock is a lock.
///
/// This is the claim behind it: documents she submits, a reviewer who decides,
/// a reason she is told, and a trail. `users.is_verified` is now written in
/// exactly one place — `AccountVerificationService.decide` — and nowhere else
/// in the codebase may set it.
model AccountVerification {
  id     String @id @default(uuid()) @db.Uuid
  /// One live claim per account: re-applying reopens this row rather than
  /// filing a second one, which is what keeps the queue answerable.
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation("AccountVerificationSubject", fields: [userId], references: [id], onDelete: Cascade)

  kind   AccountVerificationKind   @default(PERSONAL)
  status AccountVerificationStatus @default(PENDING)

  /// The name on the document, which is the thing being checked against the
  /// name on the page.
  legalName String @map("legal_name")

  /// What kind of paper it is — a national id, a passport, a commercial
  /// register. Free text on purpose: Syria's acceptable documents are not a
  /// closed set and an enum here would refuse a real woman's real paper.
  documentType String? @map("document_type")

  /// Kept out of every public serializer. These are photographs of a woman's
  /// identity card; they are readable by her and by a reviewer holding
  /// `user:verify`, and by nobody else.
  documentFrontUrl String? @map("document_front_url")
  documentBackUrl  String? @map("document_back_url")
  selfieUrl        String? @map("selfie_url")

  /// Anything else she was asked for on a second pass.
  supportingUrls Json @default("[]") @map("supporting_urls")

  /// Why she is asking, in her words. A public figure, a boutique with a
  /// counterfeit problem, a salon whose name is being used by somebody else —
  /// the reason is most of what a reviewer weighs.
  note String?

  /// What the reviewer said. `reviewNote` is shown to her; it is the whole
  /// point of `NEEDS_MORE_INFO` being a state rather than a rejection.
  reviewNote String?   @map("review_note")
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")

  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  history AccountVerificationStatusEvent[]

  /// The queue: oldest first within a status.
  @@index([status, submittedAt])
  @@map("account_verifications")
}

/// Every move a claim made, and who made it. Append-only.
model AccountVerificationStatusEvent {
  id             String              @id @default(uuid()) @db.Uuid
  verificationId String              @map("verification_id") @db.Uuid
  verification   AccountVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  status AccountVerificationStatus
  reason String

  /// Null when the account itself moved the claim — submitting, resubmitting.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("AccountVerificationReviewer", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([verificationId, createdAt])
  @@index([actorId, createdAt])
  @@map("account_verification_status_events")
}

/// «الأبرز» — a named, ordered shelf of her own stories, kept past their day.
///
/// A story expires after twenty-four hours, which is the whole point of a
/// story and the whole problem with one: the boutique's size guide, the
/// customer's «طلبيتي وصلت», the salon's before-and-after are all worth more
/// than a day and all disappeared. A highlight is the permission to keep one.
///
/// It is owner-keyed rather than seller-keyed, so a shopper's page and a
/// boutique's storefront run the same code — a highlight of «إطلالاتي» and one
/// of «مقاساتنا» differ in what is in them and in nothing else.
model ProfileHighlight {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("ProfileHighlights", fields: [ownerId], references: [id], onDelete: Cascade)

  title String

  /// Chosen by her, or null to fall back to the first item's still. Stored
  /// rather than derived because a cover she picked must survive removing the
  /// story it came from.
  coverUrl String? @map("cover_url")

  /// Her order on the rail, lowest first. Ties break on `createdAt`.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ProfileHighlightItem[]

  /// The rail, in one index-only read.
  @@index([ownerId, sortOrder, createdAt])
  @@map("profile_highlights")
}

model ProfileHighlightItem {
  id          String           @id @default(uuid()) @db.Uuid
  highlightId String           @map("highlight_id") @db.Uuid
  highlight   ProfileHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  /// The story itself, still the one row everything else reads. A highlight
  /// points at content; it never copies it, so a takedown or an edit reaches
  /// the highlight too.
  contentId String          @map("content_id") @db.Uuid
  content   CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  sortOrder Int      @default(0) @map("sort_order")
  addedAt   DateTime @default(now()) @map("added_at")

  /// The same story cannot sit twice in one highlight.
  @@unique([highlightId, contentId])
  @@index([highlightId, sortOrder, addedAt])
  @@index([contentId])
  @@map("profile_highlight_items")
}

// Directed follow edge: follower -> following.
model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model GuestSession {
  id               String             @id @default(uuid()) @db.Uuid
  tokenHash        String             @unique @map("token_hash")
  status           GuestSessionStatus @default(ACTIVE)
  deviceId         String?            @map("device_id")
  /// Lets a lost or expired guest token still find its cart: the device is
  /// known even when the token is gone.
  deviceKeyId      String?            @map("device_key_id") @db.Uuid
  deviceKey        DeviceKey?         @relation(fields: [deviceKeyId], references: [id], onDelete: SetNull)
  deviceName       String?            @map("device_name")
  platform         String?
  appVersion       String?            @map("app_version")
  fingerprintHash  String?            @map("fingerprint_hash")
  ipAddress        String?            @map("ip_address")
  userAgent        String?            @map("user_agent")
  migratedToUserId String?            @map("migrated_to_user_id") @db.Uuid
  migratedToUser   User?              @relation("GuestMigrationUser", fields: [migratedToUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime           @map("expires_at")
  lastSeenAt       DateTime           @default(now()) @map("last_seen_at")
  migratedAt       DateTime?          @map("migrated_at")
  revokedAt        DateTime?          @map("revoked_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  cartItems      GuestCartItem[]
  savedItems     GuestSavedItem[]
  securityEvents SecurityEvent[]

  @@index([status, expiresAt])
  @@index([fingerprintHash])
  @@index([migratedToUserId])
  @@index([deviceKeyId])
  @@map("guest_sessions")
}

model RefreshToken {
  id          String     @id @default(uuid()) @db.Uuid
  tokenHash   String     @unique @map("token_hash")
  tokenFamily String     @map("token_family")
  userId      String     @map("user_id") @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?    @map("session_id") @db.Uuid
  session     Session?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deviceId    String?    @map("device_id") @db.Uuid
  device      Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Binds the token to a device key. An exfiltrated refresh token is then an
  /// inert string rather than a self-renewing foothold: presenting it also
  /// requires signing a proof with a private key that never left the handset.
  deviceKeyId String?    @map("device_key_id") @db.Uuid
  deviceKey   DeviceKey? @relation(fields: [deviceKeyId], references: [id], onDelete: SetNull)
  /// Which pepper produced `tokenHash`. Rotating the pepper is impossible
  /// without this: today changing the key invalidates every live token at once.
  keyId       String?    @map("key_id")
  /// The token this one replaced — the direction actually queried when walking
  /// a family backwards after a reuse alarm.
  prevTokenId String?    @map("prev_token_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([deviceKeyId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String?       @map("device_id") @db.Uuid
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// The key the session is anchored to. Nullable only for sessions created by
  /// a client that has not registered one yet; the proof guard is what makes
  /// it mandatory where it matters.
  deviceKeyId String?       @map("device_key_id") @db.Uuid
  deviceKey   DeviceKey?    @relation(fields: [deviceKeyId], references: [id], onDelete: SetNull)
  status      SessionStatus @default(ACTIVE)
  ipAddress   String?       @map("ip_address")
  userAgent   String?       @map("user_agent")

  /// Two clocks, and the second one is the point. `idleExpiresAt` slides
  /// forward on every rotation, so an active session stays alive.
  /// `absoluteExpiresAt` never moves — without it a chain rotated once a week
  /// lives forever and there is no re-authentication checkpoint at all, which
  /// is exactly what a stolen unlocked handset relies on.
  idleExpiresAt     DateTime @map("idle_expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  /// The rung this session currently stands on.
  assuranceLevel AssuranceLevel @default(AAL1) @map("assurance_level")
  /// AAL3 is a moment, not a state: elevation lasts ten minutes and then the
  /// session drops back, so a phone left unattended after a sensitive action
  /// does not stay privileged.
  elevatedUntil  DateTime?      @map("elevated_until")

  /// Q — the SIM-swap control.
  ///
  /// For the first 24 hours after a device is seen for the first time, the
  /// sensitive actions are refused OUTRIGHT — not merely stepped up — because
  /// every step-up channel available to a consumer today routes back through
  /// the SIM the attacker is holding. This delay is the only control that does
  /// not, and it works because a swapper acts within minutes while a real
  /// owner can wait a day.
  newDeviceCooldownUntil DateTime? @map("new_device_cooldown_until")

  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  stepUpGrants  StepUpGrant[]
  pushTokens    PushToken[]

  @@index([userId, status])
  @@index([deviceId])
  @@index([deviceKeyId])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
  @@map("sessions")
}

/// Descriptive metadata about a device — its name, platform, last-seen
/// address. It is no longer the identity: that moved to `DeviceKey`, and
/// `fingerprintHash` survives only as a weak correlation hint for the fraud
/// signals that predate the key.
model Device {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKeyId     String?          @unique @map("device_key_id") @db.Uuid
  deviceKey       DeviceKey?       @relation(fields: [deviceKeyId], references: [id], onDelete: SetNull)
  fingerprintHash String           @map("fingerprint_hash")
  name            String
  platform        String?
  appVersion      String?          @map("app_version")
  trustLevel      DeviceTrustLevel @default(UNVERIFIED) @map("trust_level")
  ipAddress       String?          @map("ip_address")
  userAgent       String?          @map("user_agent")
  verifiedAt      DateTime?        @map("verified_at")
  lastSeenAt      DateTime         @default(now()) @map("last_seen_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@unique([userId, fingerprintHash])
  @@index([userId, trustLevel])
  @@map("devices")
}

// ─────────────────────── Device identity ───────────────────────

/// A device, identified by a public key it holds the private half of.
///
/// This replaces `Device.fingerprintHash` as the identity anchor, and the
/// difference is not cosmetic. The old fingerprint was SHA-256 over six
/// client-supplied headers — *including the IP address* — which meant it was
/// forgeable by anyone who could set a header, and that it changed on every
/// cell handover. Both consequences were serious: "trust this device" never
/// stuck because the next network minted a new row, revocation was not durable
/// because BLOCKED was enforced by exact-hash lookup, and the referral
/// shared-device fraud signal could be defeated by editing one header.
///
/// A public key cannot be forged, and does not change when she walks from
/// wifi onto mobile data.
model DeviceKey {
  id             String           @id @default(uuid()) @db.Uuid
  /// Null until the device is used to sign in — a visitor's device exists
  /// before any account does.
  userId         String?          @map("user_id") @db.Uuid
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Raw Ed25519 public key, base64url. Unique across the platform.
  publicKey      String           @unique @map("public_key")
  keyStorage     DeviceKeyStorage @default(SOFTWARE) @map("key_storage")
  hardwareBacked Boolean          @default(false) @map("hardware_backed")
  trustLevel     DeviceTrustLevel @default(UNVERIFIED) @map("trust_level")
  label          String?
  platform       String?
  osVersion      String?          @map("os_version")
  model          String?
  appVersion     String?          @map("app_version")
  firstSeenAt    DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime         @default(now()) @map("last_seen_at")
  /// Set when the device completed an OTP challenge — the only way trust is
  /// conferred now. There is no endpoint that simply declares a device trusted.
  verifiedAt     DateTime?        @map("verified_at")
  revokedAt      DateTime?        @map("revoked_at")
  revokedReason  String?          @map("revoked_reason")

  sessions      Session[]
  refreshTokens RefreshToken[]
  guestSessions GuestSession[]
  proofJtis     DeviceProofJti[]
  device        Device?

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
  @@map("device_keys")
}

/// Replay guard for device proofs.
///
/// A proof is valid for ±60 seconds, which is a small window but not a closed
/// one: without this table a captured proof can be replayed inside it. The
/// unique constraint is the whole mechanism — the insert either succeeds or
/// tells us the proof has been seen.
model DeviceProofJti {
  id          String    @id @default(uuid()) @db.Uuid
  deviceKeyId String    @map("device_key_id") @db.Uuid
  deviceKey   DeviceKey @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)
  jti         String
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([deviceKeyId, jti])
  @@index([expiresAt])
  @@map("device_proof_jtis")
}

/// A consumed second factor, scoped to what it was consumed for.
///
/// Scoping matters: a code the user approved to change her delivery address
/// must not silently also authorise a payout change. The grant records what
/// was asked, what satisfied it, and when — which is also the audit trail an
/// investigator needs after the fact.
/// A TOTP authenticator, RFC 6238.
///
/// Mandatory for the seven privileged roles, and the reason is an availability
/// argument rather than a cryptographic one: if Meta, the SMS aggregator and
/// the Syrian mobile network are all unreachable at once, operations staff must
/// still be able to sign in — and that is precisely the incident in which they
/// are needed. TOTP is the only factor in the system with no network in its
/// path at all.
///
/// Opt-in for shoppers, where it is the second AAL3 channel that does not
/// arrive on the SIM.
model TotpCredential {
  userId          String    @id @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM under `TOTP_ENC_KEY`. A shared secret has to be recoverable
  /// to be verified, so it is encrypted rather than hashed — and under its own
  /// key, so a database dump alone does not yield working authenticators.
  secretEnc       String    @map("secret_enc")
  confirmedAt     DateTime? @map("confirmed_at")
  /// The last time step accepted. A code is valid for 30 seconds and may be
  /// entered inside that window more than once; without this, an observer who
  /// sees one code can replay it for the rest of the step.
  lastUsedCounter BigInt?   @map("last_used_counter")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("totp_credentials")
}

/// Single-use codes she writes down.
///
/// Two jobs: satisfy AAL3 through a channel that is not the SIM, and bootstrap
/// the dead-SIM recovery path. Adoption will be low — people do not reliably
/// keep eight codes — which is exactly why the support-mediated path and the
/// optional password exist beside this rather than instead of it.
model RecoveryCode {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// argon2id — unlike an OTP these are long-lived, so they get password-grade
  /// hashing rather than a peppered HMAC.
  codeHash            String    @map("code_hash")
  /// Regenerating invalidates the previous set by bumping this.
  generation          Int       @default(1)
  usedAt              DateTime? @map("used_at")
  usedFromDeviceKeyId String?   @map("used_from_device_key_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId, generation, usedAt])
  @@map("recovery_codes")
}

model StepUpGrant {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?      @map("session_id") @db.Uuid
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// The action class this grant was requested for, e.g. `payout_details`.
  scope       String
  method      StepUpMethod
  challengeId String?      @map("challenge_id") @db.Uuid
  issuedAt    DateTime     @default(now()) @map("issued_at")
  expiresAt   DateTime     @map("expires_at")
  consumedAt  DateTime?    @map("consumed_at")
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")

  @@index([userId, scope, consumedAt])
  @@index([sessionId, expiresAt])
  @@map("step_up_grants")
}

/// A phone change in flight.
///
/// The old flow took one code — on the *new* number — and moved the account.
/// That is the whole SIM-swap attack written as a feature: whoever holds the
/// new SIM proves control of it, and the account follows. Proving control of
/// the number being left behind is what makes the change two-sided, and it is
/// the half an attacker cannot supply.
///
/// A woman whose old SIM is genuinely dead is not stuck: she goes through
/// `AccountRecoveryCase`, which is slower on purpose.
model PhoneChangeRequest {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Snapshotted, so the audit trail still reads correctly after the move.
  currentPhone      String            @map("current_phone")
  newPhone          String            @map("new_phone")
  status            PhoneChangeStatus @default(AWAITING_CURRENT)
  currentVerifiedAt DateTime?         @map("current_verified_at")
  newVerifiedAt     DateTime?         @map("new_verified_at")
  sessionId         String?           @map("session_id") @db.Uuid
  deviceKeyId       String?           @map("device_key_id") @db.Uuid
  ipAddress         String?           @map("ip_address")
  userAgent         String?           @map("user_agent")
  expiresAt         DateTime          @map("expires_at")
  completedAt       DateTime?         @map("completed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelledReason   String?           @map("cancelled_reason")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("phone_change_requests")
}

/// The last door: she lost the SIM, has no recovery code and no authenticator.
///
/// Owner decision 4 — the evidence collected here is **platform-held only**.
/// No selfies, no ID photographs. Two reasons, and the first is the binding
/// one: on a women-only platform in Syria, a support queue full of face
/// photographs is a liability whose worst case is not fraud. The second is
/// that identity documents do not actually answer the question — they prove
/// who is holding the phone, not who owns the account.
///
/// What does the work instead is structural: only Ohara knows what this account
/// bought and when, two different staff accounts must agree, seventy-two hours
/// pass during which the number on file is told what is happening, and money
/// is frozen for a week after. An attacker has to defeat all four.
model AccountRecoveryCase {
  id           String                @id @default(uuid()) @db.Uuid
  /// Resolved server-side from `claimedPhone`. Null while the claim matches no
  /// account — the case is still created and still answered identically, so
  /// this route cannot be used to ask whether a woman is on Ohara.
  userId       String?               @map("user_id") @db.Uuid
  user         User?                 @relation("RecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  claimedPhone String                @map("claimed_phone")
  /// Where she can be reached now. Verified with its own code before the case
  /// is worth a reviewer's time.
  contactPhone String                @map("contact_phone")
  status       AccountRecoveryStatus @default(SUBMITTED)

  /// Her answers, and the automatic scoring of them. Answers are stored as
  /// what was matched rather than what was typed — `{"last_order_month":
  /// true}` — so the case file itself never becomes a second copy of her
  /// order history.
  evidence  Json?
  /// 0-100. Advisory: it orders the queue, it does not decide anything.
  score     Int     @default(0)
  riskNotes String? @map("risk_notes")

  /// Dual control. Two DISTINCT staff accounts, enforced in code and by the
  /// unique-ish check on approval: one support account that has been phished
  /// must not be sufficient to hand over an account.
  firstApproverId  String?   @map("first_approver_id") @db.Uuid
  firstApprovedAt  DateTime? @map("first_approved_at")
  secondApproverId String?   @map("second_approver_id") @db.Uuid
  secondApprovedAt DateTime? @map("second_approved_at")

  /// 72 hours, starting at the second approval. The number on file is told at
  /// the start of it and can cancel with one tap.
  coolOffUntil    DateTime? @map("cool_off_until")
  /// Set when the case completes — the moment the account is handed over.
  completedAt     DateTime? @map("completed_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectedReason  String?   @map("rejected_reason")
  cancelledAt     DateTime? @map("cancelled_at")
  /// The number the account is moved to on completion.
  newPhone        String?   @map("new_phone")
  /// Opaque secret handed to the claimant; she needs it plus a code on the new
  /// number to finish. Stored as an HMAC digest.
  claimSecretHash String?   @map("claim_secret_hash")

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events AccountRecoveryEvent[]

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([claimedPhone, createdAt])
  @@index([status, coolOffUntil])
  @@map("account_recovery_cases")
}

/// Every transition on a case, with the human who caused it.
///
/// Separate from `AuditLog` on purpose: this is the record a reviewer reads
/// *while deciding*, and it has to be trivially attributable per case.
model AccountRecoveryEvent {
  id        String              @id @default(uuid()) @db.Uuid
  caseId    String              @map("case_id") @db.Uuid
  case      AccountRecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?             @map("actor_id") @db.Uuid
  actor     User?               @relation("RecoveryCaseActors", fields: [actorId], references: [id], onDelete: SetNull)
  /// `submitted`, `evidence_scored`, `approved`, `rejected`, `cancelled`,
  /// `completed`, `cool_off_started`.
  action    String
  note      String?
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@index([actorId])
  @@map("account_recovery_events")
}

model OtpRequest {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @map("user_id") @db.Uuid
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination     String
  channel         OtpChannel
  purpose         OtpPurpose
  codeHash        String     @map("code_hash")
  status          OtpStatus  @default(PENDING)
  attempts        Int        @default(0)
  maxAttempts     Int        @default(5) @map("max_attempts")
  ipAddress       String?    @map("ip_address")
  userAgent       String?    @map("user_agent")
  /// Two digits shown on screen the moment she asks for a code, and repeated
  /// inside the message. If they do not match, the message did not come from
  /// this device's request — the only defence against "this is Ohara support,
  /// read me the code", the dominant attack in WhatsApp-OTP markets.
  matchCode       String?    @map("match_code")
  /// Binds the challenge to the app instance that asked for it.
  clientNonceHash String?    @map("client_nonce_hash")

  /// Which direction this challenge's code travels. A `REVERSE_SMS` row has no
  /// usable `codeHash`: the digest is taken over a 256-bit value that is never
  /// revealed to anyone, so the code-entry path cannot satisfy it and the only
  /// way to settle it is the provider's own answer.
  deliveryMode    OtpDeliveryMode  @default(CODE_TO_HANDSET) @map("delivery_mode")
  /// The ceremony a reverse challenge is waiting on; null on a classic one.
  reverseCeremony ReverseCeremony? @map("reverse_ceremony")
  /// The provider's `vrf_…` / `pbn_…` id. Unique so one provider ceremony can
  /// never settle two challenges.
  reverseRef      String?          @unique @map("reverse_ref")
  /// The receiver number she was told to message, kept so a resend shows the
  /// same instruction and so support can answer "where did I send it?".
  reverseSendTo   String?          @map("reverse_send_to")

  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  outbox     OtpOutbox?
  deliveries ChallengeDelivery[]

  @@index([destination, purpose, status])
  @@index([userId])
  @@index([createdAt])
  @@map("otp_requests")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String    @map("role_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model SellerVerification {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @unique @map("user_id") @db.Uuid
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 SellerVerificationStatus @default(PENDING)
  businessName           String                   @map("business_name")
  legalName              String                   @map("legal_name")
  businessCategory       String?                  @map("business_category")
  storeDescription       String?                  @map("store_description")
  storeLogoUrl           String?                  @map("store_logo_url")
  contactPhone           String?                  @map("contact_phone")
  contactEmail           String?                  @map("contact_email")
  businessAddress        String?                  @map("business_address")
  warehouseAddress       String?                  @map("warehouse_address")
  commercialRegistration String?                  @unique @map("commercial_registration")
  governmentIdUrl        String?                  @map("government_id_url")
  businessLicenseUrl     String?                  @map("business_license_url")
  taxId                  String?                  @unique @map("tax_id")
  bankName               String?                  @map("bank_name")
  accountHolder          String?                  @map("account_holder")
  iban                   String?                  @map("iban")
  paymentInformation     Json?                    @map("payment_information")
  shippingMethods        Json?                    @map("shipping_methods")
  returnPolicy           String?                  @map("return_policy")
  productCategories      Json?                    @map("product_categories")
  yearsExperience        Int?                     @map("years_experience")
  website                String?
  socialMediaLinks       Json?                    @map("social_media_links")
  documentUrls           Json                     @map("document_urls")
  reviewReason           String?                  @map("review_reason")
  rejectionReason        String?                  @map("rejection_reason")
  reviewedBy             String?                  @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?                @map("reviewed_at")
  submittedAt            DateTime                 @default(now()) @map("submitted_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  history SellerVerificationStatusHistory[]

  @@index([status])
  @@map("seller_verifications")
}

model SellerVerificationStatusHistory {
  id             String                   @id @default(uuid()) @db.Uuid
  verificationId String                   @map("verification_id") @db.Uuid
  verification   SellerVerification       @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  status         SellerVerificationStatus
  reason         String
  adminId        String?                  @map("admin_id") @db.Uuid
  admin          User?                    @relation("SellerVerificationAdminActions", fields: [adminId], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([verificationId, createdAt])
  @@index([adminId, createdAt])
  @@map("seller_verification_status_history")
}

model AuditLog {
  id       String        @id @default(uuid()) @db.Uuid
  actorId  String?       @map("actor_id") @db.Uuid
  actor    User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  category String
  outcome  String
  severity AuditSeverity @default(INFO)

  /// **What was acted on**, and the reason this trail is now answerable.
  ///
  /// The log recorded who did what and when, and left the *what to* inside an
  /// unindexed `metadata` blob — so "show me everything that happened to this
  /// order" or "to this seller" had no answer, which is exactly the question
  /// asked after an incident. Nullable because some actions have no single
  /// subject (a sweep, a sign-in).
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  /// The forensic query: one record's whole history, newest first.
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  type           SecurityEventType
  riskLevel      RiskLevel         @default(LOW) @map("risk_level")
  actorId        String?           @map("actor_id") @db.Uuid
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  guestSessionId String?           @map("guest_session_id") @db.Uuid
  guestSession   GuestSession?     @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  sessionId      String?           @map("session_id") @db.Uuid
  deviceId       String?           @map("device_id") @db.Uuid
  ipAddress      String?           @map("ip_address")
  userAgent      String?           @map("user_agent")
  resource       String?
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([type, createdAt])
  @@index([riskLevel, createdAt])
  @@map("security_events")
}

// ─────────────────────── OTP delivery subsystem ───────────────────────

/// The transport chain, ordered by `priority` and flippable at runtime.
///
/// It is a table rather than a constant because the primary channel is an
/// operational decision, not an architectural one: a Meta policy action, a
/// template rejection or a carrier outage has to be survivable without a
/// deploy. The same property makes it dangerous — whoever can write this table
/// can reroute every code on the platform to a channel they control — so
/// writes are admin-only and emit a CRITICAL security event.
model OtpTransportRoute {
  id                String           @id @default(uuid()) @db.Uuid
  transport         OtpTransportKind @unique
  priority          Int              @default(100)
  enabled           Boolean          @default(true)
  /// Hard daily spend cap. The one line item that can breach the ops budget,
  /// so it degrades cost before it degrades access: tripping the breaker falls
  /// through to the cheaper transport rather than refusing to send.
  dailyBudgetMicros BigInt?          @map("daily_budget_micros")
  spentTodayMicros  BigInt           @default(0) @map("spent_today_micros")
  spentOn           DateTime?        @map("spent_on") @db.Date
  breakerTrippedAt  DateTime?        @map("breaker_tripped_at")
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  deliveries ChallengeDelivery[]

  @@index([enabled, priority])
  @@map("otp_transport_routes")
}

/// One row per challenge, drained by cron.
///
/// The code is sealed here rather than kept in memory because escalation must
/// resend the SAME code on the next transport — a user already staring at a
/// code should never be told to start over — and `otp_requests.code_hash` is a
/// one-way digest by design. Sealed with AES-256-GCM under its own key, and
/// destroyed the moment the challenge is delivered, consumed or expires.
model OtpOutbox {
  id             String          @id @default(uuid()) @db.Uuid
  challengeId    String          @unique @map("challenge_id") @db.Uuid
  challenge      OtpRequest      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sealedCode     String?         @map("sealed_code")
  status         OtpOutboxStatus @default(PENDING)
  /// Position in the transport chain; escalation advances it.
  transportIndex Int             @default(0) @map("transport_index")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now()) @map("next_attempt_at")
  lastError      String?         @map("last_error")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("otp_outbox")
}

/// One row per delivery attempt — the only place success rate, time-to-handset
/// and cost per transport can be read from.
model ChallengeDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  challengeId       String             @map("challenge_id") @db.Uuid
  challenge         OtpRequest         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  transport         OtpTransportKind
  routeId           String?            @map("route_id") @db.Uuid
  route             OtpTransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  status            OtpDeliveryStatus  @default(QUEUED)
  providerMessageId String?            @map("provider_message_id")
  costMicros        BigInt             @default(0) @map("cost_micros")
  sentAt            DateTime?          @map("sent_at")
  deliveredAt       DateTime?          @map("delivered_at")
  failedAt          DateTime?          @map("failed_at")
  failureReason     String?            @map("failure_reason")
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([challengeId, createdAt])
  @@index([transport, createdAt])
  @@index([status, sentAt])
  @@index([providerMessageId])
  @@index([routeId])
  @@map("challenge_deliveries")
}

model LoginAttempt {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  success   Boolean
  reason    String?
  ipAddress String?       @map("ip_address")
  userAgent String?       @map("user_agent")
  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────── Media ───────────────────────────

/// Every uploaded byte on the platform, in one place.
///
/// The feature tables keep storing plain URLs (`Story.mediaUrl`,
/// `ProductMedia.url`, `User.imageUrl`) — that stays unchanged, because a URL
/// is what a client needs and rewriting nine tables to carry a foreign key
/// would have been a migration with no reader. What this table adds is the
/// half a URL cannot answer: who uploaded it, how large it is, what the bytes
/// actually are as opposed to what the filename claimed, and whether anything
/// still points at it.
model MediaAsset {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Which driver wrote the bytes (`local`, later `s3`). Stored per row rather
  /// than read from config at fetch time: config changes, and an asset written
  /// to disk in March must still be readable after the platform moves to
  /// object storage in June.
  driver     String
  /// Driver-relative path. Generated, never derived from the client's
  /// filename — that is the whole defence against `../../etc/passwd`.
  storageKey String           @unique @map("storage_key")
  visibility MediaVisibility  @default(PUBLIC)
  status     MediaAssetStatus @default(PENDING)

  /// The sniffed type, not the declared one. A client may send any
  /// `Content-Type` it likes; this column records what the magic bytes said.
  mimeType String    @map("mime_type")
  kind     MediaType @default(image)
  byteSize Int       @map("byte_size")
  width    Int?
  height   Int?

  /// SHA-256 of the bytes. Lets a re-upload of the same photo be recognised,
  /// and gives an auditor something to compare a file on disk against.
  checksum String

  /// Widths of the resized copies that exist beside the original, e.g.
  /// `[480, 1080]`. A product grid renders at about 180dp — roughly 540px on a
  /// three-times display — and was fetching the full 2048px upload for it:
  /// twelve tiles of a listing page cost several megabytes to draw something
  /// the size of a postcard.
  ///
  /// Recorded rather than assumed, because an upload smaller than a variant
  /// does not get that variant (there is nothing to gain by upscaling), and
  /// because rows written before derivatives existed have none at all.
  variants Int[]

  /// A twenty-odd character string that decodes to a blurred approximation of
  /// the image. Drawn instantly from the row itself, so a card has its colours
  /// before a single byte of the photograph has arrived, instead of a grey
  /// rectangle that pops.
  blurHash String? @map("blur_hash")

  /// Kept for the seller's benefit when an admin reviews her documents
  /// ("passport.jpg" is more use than a uuid). Never used to build a path.
  originalName String? @map("original_name")

  /// Free-form label for what the upload was for (`product`, `story`,
  /// `avatar`, `verification`). Drives nothing structural — it exists so a
  /// support agent looking at an orphan can tell what the woman was doing.
  purpose String?

  attachedAt DateTime? @map("attached_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  messageAttachments MessageAttachment[]

  // Ohara Visual Shopping. All three are private uploads on retention clocks,
  // and all three are `SetNull` on the far side: deleting the photograph must
  // leave the search that used it intact, because the search is a vector and a
  // list of products rather than a picture of anybody.
  visualSearchQueries VisualSearchSession[] @relation("VisualSearchQueryAsset")
  visualTryOnSources  VisualTryOnRequest[]  @relation("VisualTryOnSourceAsset")
  visualTryOnResults  VisualTryOnRequest[]  @relation("VisualTryOnResultAsset")

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([ownerId, checksum])
  @@map("media_assets")
}

// ─────────────────────────── Taxonomy ───────────────────────────

/// Q26 — exactly three levels (0 root, 1 section, 2 leaf). Products may only
/// attach to a leaf so filters and attribute schemas stay predictable.
model Category {
  id       String     @id @default(uuid()) @db.Uuid
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  level    Int     @default(0)
  slug     String  @unique
  nameAr   String  @map("name_ar")
  nameEn   String  @map("name_en")
  iconUrl  String? @map("icon_url")
  imageUrl String? @map("image_url")

  /// Q27 — JSON-Schema for the extra attributes products here carry.
  /// Null = inherit from the nearest ancestor that defines one.
  attributeSchema Json? @map("attribute_schema")

  /// Q33 P1 — sensitive categories are gated, not silently hidden.
  isSensitive    Boolean @default(false) @map("is_sensitive")
  /// Q56 P1 — categories excluded from the change-of-mind return window.
  returnsAllowed Boolean @default(true) @map("returns_allowed")

  sizeChartId String?    @map("size_chart_id") @db.Uuid
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]
  coupons  Coupon[]

  // Ohara Trend Engine.
  demandDaily        CategoryDemandDaily[]
  trendScores        CategoryTrendScore[]
  trendInsights      TrendInsight[]
  unmetDemandSignals UnmetDemandSignal[]   @relation("UnmetDemandCategory")

  @@index([parentId, sortOrder])
  @@index([level, isActive])
  @@index([sizeChartId])
  @@map("categories")
}

/// Q25 — brands are first-class and get their own page.
model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  logoUrl     String?  @map("logo_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    Product[]
  closetItems ClosetItem[]

  @@index([isActive])
  @@map("brands")
}

/// Q29 — a different size chart per category.
model SizeChart {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  nameAr  String @map("name_ar")
  nameEn  String @map("name_en")
  columns Json
  rows    Json

  categories Category[]

  @@map("size_charts")
}

// ───────────────────────────── Catalog ─────────────────────────────

// ─────────────────────── Canonical catalog ───────────────────────

/// Q23 — the canonical product. It carries NO seller, NO price and NO stock:
/// those live on SellerOffer, which is what makes multi-seller price
/// comparison possible. `createdBySellerId` only records who proposed it.
model Product {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  title       String
  description String

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String? @map("brand_id") @db.Uuid
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  /// Validated at write time against Category.attributeSchema (Q27).
  attributes Json?

  /// Q24 — barcode is optional, but unique when present.
  gtin String? @unique

  createdBySellerId String? @map("created_by_seller_id") @db.Uuid
  createdBySeller   User?   @relation("SellerAuthoredProducts", fields: [createdBySellerId], references: [id], onDelete: SetNull)

  status           ProductStatus    @default(DRAFT)
  moderationStatus ModerationStatus @default(OPEN) @map("moderation_status")

  /// Admin curation flags (Q70 P1 — "إدارة الصفحة الرئيسية والبانرات").
  /// These belong to the canonical product, not to any one seller's offer.
  isFeatured Boolean @default(false) @map("is_featured")
  showInFeed Boolean @default(true) @map("show_in_feed")

  // Roll-ups over live offers, refreshed inside the same transaction that
  // mutates an offer. `minPrice`/`maxPrice` are normalised to SYP so the
  // catalog can be sorted and filtered by price in one currency.
  offersCount Int @default(0) @map("offers_count")

  /// What this listing is worth showing, 0–100, from `ranking/kernel`.
  ///
  /// Stored rather than computed per query, because ordering a catalogue by an
  /// expression is a sequential scan and ordering it by a column is an index.
  /// Refreshed by a sweep; `rankScoredAt` says when, so a screen can tell a
  /// seller how fresh her position is instead of implying it is live.
  rankScore     Float     @default(0) @map("rank_score")
  rankScoredAt  DateTime? @map("rank_scored_at")
  /// The components behind it, so "why is my dress on page three" has an
  /// answer that does not require re-deriving the score.
  rankBreakdown Json?     @map("rank_breakdown")

  /// Derived facts the card needs, refreshed by the same sweep that scores
  /// the listing. Denormalised so an honest badge ("bought by 12 women this
  /// month", "only 2 left") does not cost a query per card — which is the
  /// reason most catalogues either skip these or lie with a cached guess.
  liveOffersCount Int      @default(0) @map("live_offers_count")
  liveStock       Int      @default(0) @map("live_stock")
  recentOrders30  Int      @default(0) @map("recent_orders_30")
  minPriceSyp     Decimal? @map("min_price_syp") @db.Decimal(18, 4)
  maxPriceSyp     Decimal? @map("max_price_syp") @db.Decimal(18, 4)

  rating       Float @default(0)
  reviewsCount Int   @default(0) @map("reviews_count")

  /// Lifetime opens of the product page. Incremented by `products.detail`, and
  /// mirrored by a dated `AnalyticsEvent` of type PRODUCT_VIEW — the column
  /// answers "how many", the events answer "when".
  viewsCount Int @default(0) @map("views_count")

  /// `likes_count` used to sit here beside these. Nothing ever wrote it: a
  /// product cannot be liked on this platform, it can be favourited, which is
  /// `favorites_count` below and has a table behind it. The column was an
  /// invented number the product page displayed next to two real ones, so it
  /// is gone rather than quietly reconciled to a duplicate.
  ordersCount    Int @default(0) @map("orders_count")
  favoritesCount Int @default(0) @map("favorites_count")

  /// The post gestures, on a product. `likes_count` is back, and this time it
  /// has a writer: `product_likes`, incremented in the same transaction as the
  /// row. A like is public applause; a favourite (above) is her private
  /// shelf — the same split a post has between its heart and its bookmark.
  likesCount    Int @default(0) @map("likes_count")
  commentsCount Int @default(0) @map("comments_count")
  sharesCount   Int @default(0) @map("shares_count")
  /// How many women added it to their own page («أضيفي إلى صفحتي»).
  picksCount    Int @default(0) @map("picks_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media                   ProductMedia[]
  variants                ProductVariant[]
  offers                  SellerOffer[]
  contentAttributions     CommerceContentAttribution[]
  favorites               Favorite[]
  guestSavedItems         GuestSavedItem[]
  orderItems              OrderItem[]
  chats                   Chat[]
  analyticsEvents         AnalyticsEvent[]
  wishlistCollectionItems WishlistCollectionItem[]
  reviews                 ProductReview[]
  likes                   ProductLike[]
  comments                ProductComment[]
  picks                   ProductPick[]
  aiInteractions          AiInteraction[]
  aiGenerations           AiGeneration[]
  commerceContentTags     CommerceContentProductTag[]
  commerceContentEvents   CommerceContentEvent[]
  styleSignals            UserStyleSignal[]
  stylistRecommendations  AiStylistRecommendation[]
  stylistOutfitItems      AiStylistOutfitItem[]

  // Ohara Trend Engine — the facts about this product, and what they said.
  demandDaily       ProductDemandDaily[]
  healthSnapshots   ProductHealthSnapshot[]
  affinitiesFrom    ProductAffinity[]       @relation("AffinityFrom")
  affinitiesTo      ProductAffinity[]       @relation("AffinityTo")
  dropProducts      DropProduct[]
  bundleItems       BundleItem[]
  resaleListings    ResaleListing[]         @relation("ResaleOf")
  sellerDemandDaily SellerDemandDaily[]
  trendScores       ProductTrendScore[]
  trendInsights     TrendInsight[]

  // Ohara Visual Shopping — its photographs as vectors, and the searches they
  // answered.
  imageEmbeddings     ProductImageEmbedding[]
  visualSearchResults VisualSearchResult[]
  visualTryOnRequests VisualTryOnRequest[]

  // Ohara Closet — the women who own this, and the looks it is wanted for.
  closetItems     ClosetItem[]
  closetLookItems ClosetLookItem[]

  // Ohara Rooms — where it is being considered.
  roomCandidates RoomCandidate[]
  coupons        Coupon[]
  duplicateLeft  ProductDuplicateVerdict[] @relation("DuplicateLeft")
  duplicateRight ProductDuplicateVerdict[] @relation("DuplicateRight")

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([status, createdAt])
  @@index([status, minPriceSyp])
  @@index([status, ordersCount])
  @@index([status, rating])
  @@index([status, favoritesCount])
  @@index([status, isFeatured])
  @@index([moderationStatus])
  @@index([status, rankScore])
  @@index([createdBySellerId])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(image)
  sortOrder Int       @default(0) @map("sort_order")

  /// Copied from the `MediaAsset` this URL points at, when it is one of ours.
  ///
  /// Denormalised on purpose. A listing page renders twenty cards from one
  /// query; reaching the hash through a join to `media_assets` on every one of
  /// them would trade the thing it is there to buy. Null for an external link,
  /// and for anything uploaded before derivatives existed — the card then
  /// falls back to a plain placeholder, exactly as it did before.
  blurHash String? @map("blur_hash")

  /// Every product card loads its media, and this table had no index at all
  /// — so each batch of cards read the whole of it.
  @@index([productId, sortOrder])
  @@map("product_media")
}

/// A canonical option combination ({size: M, color: red}). Price and stock are
/// NOT here — they are per offer, on SellerOfferVariant.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String
  /// Q34 — { size: "M", color: "أحمر", shade: "N05", scent: "..." }
  attributes Json
  /// Q34 — a different image per option.
  imageUrl   String? @map("image_url")
  sortOrder  Int     @default(0) @map("sort_order")

  offerVariants       SellerOfferVariant[]
  commerceContentTags CommerceContentProductTag[]
  closetItems         ClosetItem[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────── Offers ───────────────────────────

/// One seller's listing of one canonical product. Carts, orders, commissions
/// and inventory all point HERE, never at the bare Product.
model SellerOffer {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String  @map("seller_id") @db.Uuid
  seller    User    @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)

  /// Q45 — the seller chooses the pricing currency; the counter-value is
  /// derived through the active ExchangeRate and frozen onto the order.
  currency       Currency @default(SYP)
  price          Decimal  @db.Decimal(18, 4)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 4)

  /// [price] converted to SYP, refreshed by `CatalogRollupService` on every
  /// offer mutation. It exists because ordering offers by the raw `price`
  /// column compares numbers across currencies: a $9.50 offer sorted ahead of
  /// every SYP one and was served as the "cheapest" on the card, so the price
  /// a customer saw belonged to the more expensive seller. Every offer
  /// ordering — the product page's comparison list and the single offer a
  /// card carries — sorts on this instead. Null only until the first roll-up.
  priceSyp Decimal? @map("price_syp") @db.Decimal(18, 4)

  /// Q35 — wholesale pricing for B2B accounts; null = retail only.
  wholesalePrice  Decimal? @map("wholesale_price") @db.Decimal(18, 4)
  wholesaleMinQty Int?     @map("wholesale_min_qty")

  stock       Int  @default(0)
  minOrderQty Int  @default(1) @map("min_order_qty")
  maxOrderQty Int? @map("max_order_qty")

  sku          String?
  handlingDays Int     @default(1) @map("handling_days")

  /// Q30 — made-to-order goods (3D prints, flower arrangements).
  isMadeToOrder   Boolean  @default(false) @map("is_made_to_order")
  requiresDeposit Boolean  @default(false) @map("requires_deposit")
  depositPercent  Decimal? @map("deposit_percent") @db.Decimal(5, 2)
  acceptsReturns  Boolean  @default(true) @map("accepts_returns")

  status   OfferStatus @default(DRAFT)
  isActive Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants       SellerOfferVariant[]
  batches        InventoryBatch[]
  reservations   InventoryReservation[]
  cartItems      CartItem[]
  bundleItems    BundleItem[]           @relation("BundleOffers")
  guestCartItems GuestCartItem[]
  orderItems     OrderItem[]
  closetItems    ClosetItem[]
  roomCandidates RoomCandidate[]
  planItems      PurchasePlanItem[]
  flashSaleItems FlashSaleItem[]        @relation("FlashSaleOffers")
  promotions     ProductPromotion[]     @relation("PromotedOffers")

  @@unique([productId, sellerId])
  @@index([sellerId, status])
  @@index([productId, status, price])
  @@index([productId, status, priceSyp])
  @@index([status, isActive])
  @@map("seller_offers")
}

model SellerOfferVariant {
  id        String         @id @default(uuid()) @db.Uuid
  offerId   String         @map("offer_id") @db.Uuid
  offer     SellerOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Null = inherit the offer price.
  price Decimal? @db.Decimal(18, 4)
  stock Int      @default(0)
  sku   String?

  cartItems      CartItem[]
  guestCartItems GuestCartItem[]
  roomCandidates RoomCandidate[]
  planItems      PurchasePlanItem[]
  reservations   InventoryReservation[]

  @@unique([offerId, variantId])
  @@index([variantId])
  @@map("seller_offer_variants")
}

/// Q32 — expiry and batch tracking, with auto-block once a batch expires.
model InventoryBatch {
  id        String      @id @default(uuid()) @db.Uuid
  offerId   String      @map("offer_id") @db.Uuid
  offer     SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  batchRef  String      @map("batch_ref")
  quantity  Int
  expiresAt DateTime?   @map("expires_at")
  alertDays Int         @default(30) @map("alert_days")
  blockedAt DateTime?   @map("blocked_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([offerId, batchRef])
  @@index([expiresAt])
  @@map("inventory_batches")
}

/// Why a unit is off the shelf, and what will put it back.
///
/// Stock has always come off `SellerOffer.stock` inside the checkout
/// transaction — that is what makes the oversell guarantee work — but nothing
/// recorded *which* order took it or under what terms. Three things followed
/// from that, and this table is what fixes all three:
///
///  1. **Releasing was not idempotent.** `restock` incremented the column
///     unconditionally, so any path that ran twice — a retried cancellation, a
///     refusal recorded by both the courier and the carrier's webhook — handed
///     the seller units she never got back. A reservation can only leave
///     `HELD`/`COMMITTED` once, and the state is the guard.
///  2. **The release depended on the order lifecycle.** If a sub-order wedged
///     in a state nobody could move it out of, its stock was gone for good.
///     A reservation expires on its own clock, so the shelf recovers even when
///     the order does not.
///  3. **A seller could not tell "sold" from "spoken for".** `stock` answers
///     "how many can I sell", and now this answers "where did the rest go".
///
/// `SellerOffer.stock` still means *available*, deliberately: every catalogue
/// read, every card and every roll-up already reads it, and redefining it as
/// "physically present" would have made availability a join on the hot path.
model InventoryReservation {
  id String @id @default(uuid()) @db.Uuid

  offerId String      @map("offer_id") @db.Uuid
  offer   SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// The chosen size or colour, when the line named one. Its stock is a
  /// separate counter and is reserved alongside the offer's.
  offerVariantId String?             @map("offer_variant_id") @db.Uuid
  offerVariant   SellerOfferVariant? @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null only for the instant between the parent order and its parcels.
  sellerOrderId String?      @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  quantity Int
  state    InventoryReservationState @default(HELD)

  /// When an unconfirmed hold lets go by itself. Cleared on COMMITTED — a
  /// parcel a seller is packing must never be released by a timer.
  expiresAt DateTime? @map("expires_at")

  committedAt   DateTime? @map("committed_at")
  consumedAt    DateTime? @map("consumed_at")
  releasedAt    DateTime? @map("released_at")
  /// Why it went back on the shelf, for the seller's own inventory history.
  releaseReason String?   @map("release_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The sweeper's only query.
  @@index([state, expiresAt])
  @@index([orderId])
  @@index([sellerOrderId])
  /// "What is spoken for on this listing", for the seller's stock screen.
  @@index([offerId, state])
  @@index([offerVariantId])
  @@map("inventory_reservations")
}

/// One unsafe request, and the answer it already got.
///
/// A woman on a Syrian mobile connection taps «إتمام الشراء», the request is in
/// flight for eight seconds, and she taps again. Without this she has two
/// orders: two stock claims, two cash collections at her door, and a support
/// conversation to unpick it. The client sends an `Idempotency-Key` with every
/// unsafe request; the second attempt with the same key is answered from here
/// rather than executed.
///
/// Deliberately keyed on `(scope, key)` and not on the key alone. The scope is
/// the principal — her account, or her guest session — so one customer's key
/// can never collide with another's, and a key guessed by a stranger reaches
/// nothing of hers.
///
/// `requestHash` is what makes the replay honest: the same key with a
/// *different* body is a client bug, and answering it with the first response
/// would silently drop the second order. It is refused instead.
model IdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid

  /// The client's key. Opaque to the platform.
  key   String
  /// Who sent it: `user:<id>`, `guest:<id>`, or `ip:<address>` for a caller
  /// with neither. Never a bare key — see the model comment.
  scope String

  /// `POST /orders/checkout`. Stored so a key reused across endpoints reads as
  /// the mistake it is rather than replaying the wrong answer.
  endpoint    String
  /// SHA-256 of the canonicalised body.
  requestHash String @map("request_hash")

  state IdempotencyState @default(IN_FLIGHT)

  /// The answer, once there is one. Absent while in flight.
  statusCode Int?  @map("status_code")
  response   Json?

  /// When this record stops answering for the request. A key is not a
  /// permanent name for an order; it is a short window against a double tap.
  expiresAt DateTime @map("expires_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@unique([scope, key])
  /// The sweeper's only query.
  @@index([expiresAt])
  @@map("idempotency_records")
}

enum IdempotencyState {
  /// A request with this key is running right now.
  IN_FLIGHT
  /// It finished, and `response` is what it answered.
  COMPLETED
}

enum InventoryReservationState {
  /// Off the shelf, awaiting payment or confirmation. Expires by itself.
  HELD
  /// The order is confirmed and the seller is preparing it. No longer expires.
  COMMITTED
  /// Delivered. The units are gone; anything coming back is a return, which is
  /// new stock arriving rather than this reservation being undone.
  CONSUMED
  /// Back on the shelf.
  RELEASED
}

/// Q46/Q47 — rate history. An order freezes the row it was priced with, so
/// every later recomputation (refund, commission, payout) agrees with it.
model ExchangeRate {
  id            String    @id @default(uuid()) @db.Uuid
  base          Currency
  quote         Currency
  rate          Decimal   @db.Decimal(18, 6)
  source        String    @default("manual")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@index([base, quote, effectiveFrom])
  @@map("exchange_rates")
}

// ───────────────────────────── Social ─────────────────────────────
//
// One content platform. `posts`, `post_likes`, `post_saves`, `comments`,
// `stories`, `story_views` and `story_reactions` used to live here and were
// folded into `commerce_contents` and its satellites — one object model for
// posts, reels, stories and whatever the registry grows next, with one feed,
// one analytics ledger and one moderation path.
//
// `/posts/*` and `/stories/*` still answer their original contract; they are
// adapters over these tables now. See `legacy-social.serializer.ts`.

model CommerceContentTypeDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  description  String?
  schema       Json
  uiSchema     Json?    @map("ui_schema")
  capabilities Json?
  lifecycle    Json?
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contents CommerceContent[]

  @@index([active])
  @@map("commerce_content_type_definitions")
}

model CommerceContent {
  id String @id @default(uuid()) @db.Uuid

  /// Whoever published it. This column was `seller_id` until customers could
  /// publish too; the platform is author-owned now, and a boutique is simply
  /// one kind of author.
  authorId String @map("author_id") @db.Uuid
  author   User   @relation("AuthoredCommerceContents", fields: [authorId], references: [id], onDelete: Cascade)

  /// What she was when she wrote it. See `CommerceAuthorKind` — it is a
  /// historical fact, not a denormalisation of her current role, and every
  /// feed, moderation queue and analytics split filters on it rather than
  /// joining `users` to ask.
  authorKind CommerceAuthorKind @map("author_kind")

  /// Whether the author's page was public when this row was last touched.
  ///
  /// The one denormalisation here whose staleness would be a *privacy* bug
  /// rather than a stale number, so it fails closed (`false` hides) and is
  /// flipped inside the same transaction as `users.profile_is_public`. Always
  /// true for a seller: a storefront nobody may look at is not a storefront.
  authorIsPublic Boolean @default(false) @map("author_is_public")

  contentType        String                              @map("content_type")
  typeDefinition     CommerceContentTypeDefinition       @relation(fields: [contentType], references: [key], onDelete: Restrict)
  title              String?
  body               String?
  locale             String                              @default("en")
  status             CommerceContentStatus               @default(DRAFT)
  visibility         CommerceContentVisibility           @default(PUBLIC)
  moderationStatus   CommerceContentModerationStatus     @default(PENDING) @map("moderation_status")
  payload            Json
  metadata           Json?
  publicationTargets CommerceContentPublicationChannel[] @default([HOME_FEED]) @map("publication_targets")
  scheduledAt        DateTime?                           @map("scheduled_at")
  publishedAt        DateTime?                           @map("published_at")
  expiresAt          DateTime?                           @map("expires_at")
  archivedAt         DateTime?                           @map("archived_at")
  pinnedUntil        DateTime?                           @map("pinned_until")
  impressionsCount   BigInt                              @default(0) @map("impressions_count")
  viewsCount         BigInt                              @default(0) @map("views_count")
  uniqueViewersCount BigInt                              @default(0) @map("unique_viewers_count")
  engagementCount    BigInt                              @default(0) @map("engagement_count")
  productClicksCount BigInt                              @default(0) @map("product_clicks_count")
  ordersCount        BigInt                              @default(0) @map("orders_count")
  sharesCount        BigInt                              @default(0) @map("shares_count")
  savesCount         BigInt                              @default(0) @map("saves_count")
  repliesCount       BigInt                              @default(0) @map("replies_count")
  reactionsCount     BigInt                              @default(0) @map("reactions_count")
  watchTimeMs        BigInt                              @default(0) @map("watch_time_ms")
  revenueCurrency    Currency                            @default(SYP) @map("revenue_currency")
  revenueGenerated   Decimal                             @default(0) @map("revenue_generated") @db.Decimal(18, 4)
  lastEngagementAt   DateTime?                           @map("last_engagement_at")

  /// The takedown, denormalised. The full trail lives in
  /// `CommerceContentModerationAction`; these three are here because the
  /// moderation queue and — more importantly — the author's own «لماذا اختفى
  /// منشوري» screen both need the answer in the row they already loaded.
  removedAt     DateTime? @map("removed_at")
  removedById   String?   @map("removed_by_id") @db.Uuid
  removedBy     User?     @relation("CommerceContentRemovers", fields: [removedById], references: [id], onDelete: SetNull)
  removalReason String?   @map("removal_reason")

  /// What the moderation queue sorts by. Incremented by the public report
  /// endpoint, which writes a `ModerationCase` for the queue itself.
  reportsCount Int @default(0) @map("reports_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media                   CommerceContentMedia[]
  productTags             CommerceContentProductTag[]
  versions                CommerceContentVersion[]
  events                  CommerceContentEvent[]
  viewers                 CommerceContentViewer[]
  moderationActions       CommerceContentModerationAction[]
  reactions               CommerceContentReaction[]
  saves                   CommerceContentSave[]
  comments                CommerceContentComment[]
  reshares                CommerceContentReshare[]          @relation("ResharedContent")
  attributions            CommerceContentAttribution[]
  guestSavedItems         GuestSavedItem[]
  wishlistCollectionItems WishlistCollectionItem[]
  highlightItems          ProfileHighlightItem[]
  /// Her page timeline, and branch A of the following feed. Keyset-ordered, so
  hiddenBy                ContentHide[]

  /// Her authoring workspace: drafts and scheduled rows, most recently touched
  /// first.
  @@index([authorId, status, updatedAt(sort: Desc)])
  /// the index carries the whole ORDER BY.
  @@index([authorId, status, publishedAt(sort: Desc), id(sort: Desc)])
  /// One index for every format-scoped feed — reels today, whatever the
  /// registry grows tomorrow.
  @@index([contentType, status, visibility, publishedAt(sort: Desc), id(sort: Desc)])
  /// The stories tray: one format, still live.
  @@index([contentType, status, expiresAt])
  @@index([status, scheduledAt])
  @@index([status, expiresAt])
  /// For the narrow channels (offers, collections) where array membership is
  /// the selective term rather than recency.
  @@index([publicationTargets(ops: ArrayOps)], map: "commerce_contents_publication_targets_gin", type: Gin)
  /// One more index exists on this table that is NOT listed here, because the
  /// schema language has no syntax for it: `commerce_contents_public_feed_idx`,
  /// a PARTIAL index on (published_at DESC, id DESC) WHERE status = 'PUBLISHED'
  /// AND visibility = 'PUBLIC' AND author_is_public, created in
  /// `20260906190200_social_platform_tables`.
  ///
  /// It is the public feed's driving index — small, because it holds only the
  /// rows a feed can ever return, and it carries the entire ORDER BY rather
  /// than feeding a sort. Do not drop it for being absent from this list.
  @@index([removedById])
  @@map("commerce_contents")
}

model CommerceContentMedia {
  id           String          @id @default(uuid()) @db.Uuid
  contentId    String          @map("content_id") @db.Uuid
  content      CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  url          String
  type         MediaType       @default(image)
  thumbnailUrl String?         @map("thumbnail_url")
  streamingUrl String?         @map("streaming_url")
  altText      String?         @map("alt_text")
  blurHash     String?         @map("blur_hash")
  durationMs   Int?            @map("duration_ms")
  metadata     Json?
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([contentId, sortOrder])
  @@map("commerce_content_media")
}

model CommerceContentProductTag {
  id           String          @id @default(uuid()) @db.Uuid
  contentId    String          @map("content_id") @db.Uuid
  content      CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  productId    String          @map("product_id") @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?         @map("variant_id") @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  role         String          @default("featured")
  displayLabel String?         @map("display_label")
  x            Float?
  y            Float?
  targetUrl    String?         @map("target_url")
  metadata     Json?
  sortOrder    Int             @default(0) @map("sort_order")

  /// Why this tag was allowed to exist.
  ///
  /// Not decoration. A seller may tag what she sells; a shopper may tag what
  /// she actually received. The creator-rewards programme will pay on tags,
  /// and a payout against a tag nobody can justify is a chargeback — so the
  /// justification is recorded at write time rather than re-derived later from
  /// an order history that may since have changed.
  basis ContentTagBasis @default(SELLER_OFFER)

  /// The delivered line that proves a `PURCHASE` tag. Null for the other two
  /// bases.
  sourceOrderItemId String?    @map("source_order_item_id") @db.Uuid
  sourceOrderItem   OrderItem? @relation(fields: [sourceOrderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  /// One delivered line justifies one tag per post — so she may post the same
  /// dress twice, and may not claim it twice within one post.
  @@unique([contentId, sourceOrderItemId])
  @@index([contentId, sortOrder])
  @@index([productId])
  @@index([variantId])
  /// The «نساء يرتدينها» rail on a product page, newest tag first.
  @@index([productId, createdAt(sort: Desc)])
  @@index([sourceOrderItemId])
  @@map("commerce_content_product_tags")
}

model CommerceContentVersion {
  id          String          @id @default(uuid()) @db.Uuid
  contentId   String          @map("content_id") @db.Uuid
  content     CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  changeNote  String?         @map("change_note")
  createdById String          @map("created_by_id") @db.Uuid
  createdBy   User            @relation("CommerceContentVersionAuthors", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([contentId, version])
  @@index([contentId, createdAt])
  @@index([createdById])
  @@map("commerce_content_versions")
}

model CommerceContentEvent {
  id          String                            @id @default(uuid()) @db.Uuid
  contentId   String                            @map("content_id") @db.Uuid
  content     CommerceContent                   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actorId     String?                           @map("actor_id") @db.Uuid
  actor       User?                             @relation("CommerceContentEventActors", fields: [actorId], references: [id], onDelete: SetNull)
  type        CommerceContentAnalyticsEventType
  productId   String?                           @map("product_id") @db.Uuid
  product     Product?                          @relation(fields: [productId], references: [id], onDelete: SetNull)
  value       Float?
  watchTimeMs Int?                              @map("watch_time_ms")
  metadata    Json?
  createdAt   DateTime                          @default(now()) @map("created_at")

  @@index([contentId, type, createdAt])
  @@index([actorId, createdAt])
  @@index([productId])
  @@map("commerce_content_events")
}

model CommerceContentViewer {
  id            String          @id @default(uuid()) @db.Uuid
  contentId     String          @map("content_id") @db.Uuid
  content       CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId        String          @map("user_id") @db.Uuid
  viewsCount    Int             @default(1) @map("views_count")
  firstViewedAt DateTime        @default(now()) @map("first_viewed_at")
  lastViewedAt  DateTime        @default(now()) @map("last_viewed_at")

  @@unique([contentId, userId])
  @@index([contentId, lastViewedAt])
  /// "Which of these sixty stories has she already seen" — one index scan
  /// rather than sixty probes. The table had no viewer-keyed index at all.
  @@index([userId, contentId])
  @@map("commerce_content_viewers")
}

/// A like on a post or reel, and an emoji on a story — one table, because it
/// is one gesture under one rule: at most one per woman per piece. That is
/// exactly what both legacy tables enforced (`post_likes(post_id, user_id)`
/// and `story_reactions(story_id, user_id)`), and splitting them again would
/// mean two answers to "has she reacted".
///
/// This is the table the counters cannot replace. `commerce_contents` carries
/// `reactions_count`, but a number cannot answer *"has **this** viewer liked
/// it"* — which is the one thing every feed card has to render.
model CommerceContentReaction {
  id        String          @id @default(uuid()) @db.Uuid
  contentId String          @map("content_id") @db.Uuid
  content   CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation("CommerceContentReactions", fields: [userId], references: [id], onDelete: Cascade)

  kind CommerceContentReactionKind @default(LIKE)

  /// Hers, verbatim, for a story reaction — `my_reaction` in the story
  /// contract is this exact string. Null for a plain like.
  emoji String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contentId, userId])
  /// `is_liked` across a page of twenty, in one index scan rather than twenty
  /// probes.
  @@index([userId, contentId])
  @@index([contentId, createdAt(sort: Desc)])
  @@map("commerce_content_reactions")
}

enum CommerceContentReactionKind {
  /// The double-tap on a feed card. What `post_likes` was.
  LIKE

  /// A story reaction, carrying its own glyph.
  EMOJI
}

model CommerceContentSave {
  id        String          @id @default(uuid()) @db.Uuid
  contentId String          @map("content_id") @db.Uuid
  content   CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation("CommerceContentSaves", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([contentId, userId])
  @@index([userId, contentId])
  /// Her saved shelf, newest first. Replaces the `post_saves` read
  /// (`where: { saves: { some: { userId } } }`), a correlated subquery no
  /// index can serve at any size.
  @@index([userId, createdAt(sort: Desc)])
  @@map("commerce_content_saves")
}

enum CommerceContentCommentStatus {
  VISIBLE

  /// Hidden by the content's author or by a moderator. The row stays: a
  /// deleted comment that leaves no trace is how a harassment report loses its
  /// own evidence, and Q103 asks for hiding as an action distinct from
  /// deleting.
  REMOVED
}

model CommerceContentComment {
  id        String          @id @default(uuid()) @db.Uuid
  contentId String          @map("content_id") @db.Uuid
  content   CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation("CommerceContentComments", fields: [userId], references: [id], onDelete: Cascade)

  /// Null for a top-level comment. **One level only** — a reply to a reply is
  /// re-parented to the thread root at write time, because the card renders
  /// two levels and a third would be invisible rather than merely ugly.
  parentId String?                  @map("parent_id") @db.Uuid
  parent   CommerceContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CommerceContentComment[] @relation("CommentReplies")

  body String

  /// Denormalised so a thread header can say how many replies it has without a
  /// second query per row.
  repliesCount Int @default(0) @map("replies_count")

  status        CommerceContentCommentStatus @default(VISIBLE)
  removedAt     DateTime?                    @map("removed_at")
  removedById   String?                      @map("removed_by_id") @db.Uuid
  removedBy     User?                        @relation("CommerceCommentRemovers", fields: [removedById], references: [id], onDelete: SetNull)
  removalReason String?                      @map("removal_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The thread read: top level newest-first, then each parent's replies.
  @@index([contentId, parentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  /// `listReplies` filters on `parentId` alone. The composite above leads
  /// with `contentId` and so cannot serve it — every tap on "show replies"
  /// was reading the whole comment table.
  @@index([parentId, createdAt])
  @@index([removedById])
  @@map("commerce_content_comments")
}

/// She put somebody else's post on her own page.
///
/// A pointer, never a copy. The media, the caption and the product tags stay
/// on the original row and are read through it, so a boutique correcting a
/// price or a moderator taking a post down reaches every page it was ever
/// added to. The only thing that is hers is `note` — what she said about it.
///
/// Interactions attach to the ORIGINAL, always. Two women reshare the same
/// look and a third likes it on both pages: one row, one like, one number on
/// the boutique's dashboard. That is what "the same post" means.
model CommerceContentReshare {
  id String @id @default(uuid()) @db.Uuid

  /// Always the root. Resharing a reshare records the root, so the chain
  /// cannot deepen and no read ever has to walk it.
  sourceContentId String          @map("source_content_id") @db.Uuid
  sourceContent   CommerceContent @relation("ResharedContent", fields: [sourceContentId], references: [id], onDelete: Cascade)

  resharerId String @map("resharer_id") @db.Uuid
  resharer   User   @relation("CommerceContentReshares", fields: [resharerId], references: [id], onDelete: Cascade)

  /// The original's author, denormalised. Every "who promoted me" read filters
  /// on it; without the column each one joins back through `commerce_contents`
  /// to reach an id the row already implies.
  sourceAuthorId String @map("source_author_id") @db.Uuid
  sourceAuthor   User   @relation("ResharedFromAuthor", fields: [sourceAuthorId], references: [id], onDelete: Cascade)

  /// Whose page she found it on, when it was not the original's. A chain is a
  /// referral path, and one that was never recorded cannot be reconstructed
  /// when the ambassador programme comes asking for it.
  viaReshareId String?                  @map("via_reshare_id") @db.Uuid
  viaReshare   CommerceContentReshare?  @relation("ReshareChain", fields: [viaReshareId], references: [id], onDelete: SetNull)
  chained      CommerceContentReshare[] @relation("ReshareChain")

  note String?

  visibility CommerceContentVisibility @default(PUBLIC)

  /// Mirrors `users.profile_is_public`, flipped in the same transaction, for
  /// the same fail-closed reason as `commerce_contents.author_is_public`. A
  /// reshare by a woman who has closed her page must leave the feed even
  /// though the boutique post behind it is still public.
  resharerIsPublic Boolean @default(false) @map("resharer_is_public")

  /// The programme this was made under. Unconstrained text, exactly as
  /// `referral_codes.campaign` is — the table it would point at does not exist
  /// yet, and a bare uuid pretending to be a foreign key is worse than a key
  /// that admits it is one.
  campaignKey String? @map("campaign_key")

  /// The code she was given to promote with. Nullable today; the column is
  /// here so the rewards programme becomes a write path and a read rather than
  /// a migration of a live table.
  couponId String? @map("coupon_id") @db.Uuid
  coupon   Coupon? @relation("ReshareCoupons", fields: [couponId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  attributions CommerceContentAttribution[]

  /// Idempotent: adding the same post twice is a no-op, not a second row.
  @@unique([sourceContentId, resharerId])
  /// Her page timeline, branch B.
  @@index([resharerId, createdAt(sort: Desc), id(sort: Desc)])
  /// "Who promoted me", for the original author.
  @@index([sourceAuthorId, createdAt(sort: Desc)])
  @@index([sourceContentId, createdAt(sort: Desc)])
  @@index([couponId])
  @@index([viaReshareId])
  @@map("commerce_content_reshares")
}

/// What entitles somebody to tag a product in her content.
///
/// Evaluated as a set and OR'd, never switched on role: a seller who bought a
/// dress from another boutique may post about it, and a role switch would
/// refuse her forever.
enum ContentTagBasis {
  /// The tagger holds a live offer on it.
  SELLER_OFFER

  /// The tagger was actually delivered it.
  PURCHASE

  /// Staff, editing on somebody's behalf.
  ADMIN
}

enum CommerceAttributionSource {
  /// The seller wrote it herself.
  AUTHOR

  /// Somebody else wrote it and tagged a product this seller offers.
  PRODUCT_TAG

  /// Somebody put a piece attributed to this seller on her own page.
  RESHARE
}

/// Which boutiques a piece of content earns credit for, and why.
///
/// **A projection, not a fact.** Every row is derivable from
/// `commerce_contents.author_id`, `commerce_content_product_tags` and
/// `commerce_content_reshares`. It exists because that derivation is a
/// three-way join fanning out through `seller_offers`, and the boutique
/// dashboard asks on every load — so the question that would get slower every
/// week becomes one index scan instead.
///
/// Rebuildable in full, delete-then-insert per content id, which is also why
/// it carries no unique constraint: uniqueness here is a property of the
/// single writer (`ContentAttributionService`), not of an index over three
/// nullable columns.
model CommerceContentAttribution {
  id String @id @default(uuid()) @db.Uuid

  contentId String          @map("content_id") @db.Uuid
  content   CommerceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  sellerId String @map("seller_id") @db.Uuid
  seller   User   @relation("CommerceContentAttributions", fields: [sellerId], references: [id], onDelete: Cascade)

  source CommerceAttributionSource

  /// The product that earned the credit. Null for `AUTHOR`, where the credit
  /// is the post itself. Non-null otherwise, because "which of my pieces did
  /// she promote" is the question, and a content id cannot answer it.
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  reshareId String?                 @map("reshare_id") @db.Uuid
  reshare   CommerceContentReshare? @relation(fields: [reshareId], references: [id], onDelete: Cascade)

  /// Who did the promoting — the author for AUTHOR and PRODUCT_TAG, the
  /// resharer for RESHARE. Denormalised so "how many different women" is a
  /// COUNT(DISTINCT) on this table alone, with no join.
  ///
  /// Whether she may be *named* is deliberately not stored here. That is read
  /// at serialization time off `users.profile_is_public`, so a woman who
  /// closes her page becomes a number again on the boutique's screen
  /// immediately rather than at the next rebuild.
  actorId String @map("actor_id") @db.Uuid
  actor   User   @relation("CommerceAttributionActors", fields: [actorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId, source, createdAt(sort: Desc)])
  @@index([sellerId, productId, createdAt(sort: Desc)])
  @@index([sellerId, actorId])
  @@index([contentId])
  @@index([actorId])
  @@index([productId])
  @@index([reshareId])
  @@map("commerce_content_attributions")
}

model CommerceContentModerationAction {
  id          String                           @id @default(uuid()) @db.Uuid
  contentId   String                           @map("content_id") @db.Uuid
  content     CommerceContent                  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  moderatorId String                           @map("moderator_id") @db.Uuid
  moderator   User                             @relation("CommerceContentModerators", fields: [moderatorId], references: [id], onDelete: Cascade)
  fromStatus  CommerceContentModerationStatus? @map("from_status")
  toStatus    CommerceContentModerationStatus  @map("to_status")
  reason      String?
  metadata    Json?
  createdAt   DateTime                         @default(now()) @map("created_at")

  @@index([contentId, createdAt])
  @@index([moderatorId, createdAt])
  /// A CHECK constraint lives on this table that the schema language cannot
  /// express — `commerce_content_moderation_actions_reason_required`, which
  /// demands a reason of at least ten characters for every decision except
  /// APPROVED. `reason` is therefore nullable here and mandatory in practice
  /// for a takedown: approving genuinely has nothing to explain, so the
  /// obligation is conditional and nullability cannot model it.
  @@map("commerce_content_moderation_actions")
}

// ───────────────────────────── Commerce ─────────────────────────────

/// Parent order: one checkout, one payment, one shipping charge (Q65 P1),
/// one frozen FX rate (Q46 P2). Fulfilment happens on the sub-orders.
model Order {
  id     String @id @default(uuid()) @db.Uuid
  number String @unique

  /// Null for a guest checkout (Q46 P1 — guests may buy).
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestSessionId String? @map("guest_session_id") @db.Uuid

  status OrderStatus @default(PENDING_PAYMENT)

  // ── Money: one currency for the whole order, frozen at creation ────────
  currency       Currency       @default(SYP)
  fxRate         Decimal        @map("fx_rate") @db.Decimal(18, 6)
  fxRateId       String?        @map("fx_rate_id") @db.Uuid
  fxRateRef      ExchangeRate?  @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  fxFrozenAt     DateTime       @default(now()) @map("fx_frozen_at")
  roundingPolicy RoundingPolicy @default(NEAREST_10) @map("rounding_policy")

  itemsSubtotal Decimal @map("items_subtotal") @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(18, 4)
  shippingTotal Decimal @default(0) @map("shipping_total") @db.Decimal(18, 4)
  walletApplied Decimal @default(0) @map("wallet_applied") @db.Decimal(18, 4)
  pointsApplied Decimal @default(0) @map("points_applied") @db.Decimal(18, 4)
  grandTotal    Decimal @map("grand_total") @db.Decimal(18, 4)

  couponCode String? @map("coupon_code")

  // ── Address snapshot (never a live FK) ────────────────────────────────
  recipientName  String  @map("recipient_name")
  recipientPhone String  @map("recipient_phone")
  governorate    String
  district       String?
  city           String
  addressLine    String  @map("address_line")
  landmark       String?
  /// The map pin, copied like the rest of the address. Null when she typed.
  latitude       Float?
  longitude      Float?

  /// Q44 P1 — hide the customer's identity from the seller; enforced per
  /// sub-order according to its fulfilment mode (Q57 P2).
  privacyMaskEnabled Boolean @default(false) @map("privacy_mask_enabled")

  deliveryInstructions String?   @map("delivery_instructions")
  notes                String?
  placedAt             DateTime? @map("placed_at")

  /// When an unpaid order stops holding its stock.
  ///
  /// Stock comes off the seller's offer the moment an order is created, so an
  /// order that is never paid for is a garment nobody else can buy. Cash
  /// orders held for a confirmation code already expire through
  /// `CodRiskAssessment.expiresAt`; this is the deadline for every *other*
  /// way an order can be left `PENDING_PAYMENT` — a transfer she never sent,
  /// a gateway she closed, or a crash between creating the order and
  /// confirming it. The window depends on what the rail asks of her: see
  /// `orders/order-expiry.ts`.
  ///
  /// Only meaningful while the order is `PENDING_PAYMENT`. It is left in place
  /// afterwards rather than cleared, so the row still records the deadline the
  /// order beat.
  expiresAt DateTime? @map("expires_at")

  /// When this order's purchase rewards (tier spend, bonus points, cashback,
  /// a referral's reward) were granted. They are granted once, when every
  /// parcel has reached its end — never at checkout, where an order can still
  /// be cancelled or left unpaid. Claimed by a conditional update, so the
  /// sweep and the escrow release cannot both grant them.
  rewardsGrantedAt DateTime? @map("rewards_granted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sellerOrders      SellerOrder[]
  payment           Payment?
  codRiskAssessment CodRiskAssessment?
  events            OrderEvent[]
  analyticsEvents   AnalyticsEvent[]
  cashbackEntries   CashbackLedger[]
  invoices          Invoice[]

  /// The Ohara Rooms plan this order was placed from, when it came from one
  /// rather than from the cart. At most one — a plan orders once.
  purchasePlans PurchasePlan[]

  /// What this order took off the shelf, and on what terms.
  reservations InventoryReservation[]

  @@index([userId, createdAt])
  @@index([guestSessionId])
  @@index([status])
  /// The expiry sweep's only query: unpaid orders past their deadline. Without
  /// this it is a scan of every order the platform has ever taken, every ten
  /// minutes, for ever.
  @@index([status, expiresAt])
  @@index([fxRateId])
  @@map("orders")
}

/// Q40 — "طلب أب واحد + طلبات فرعية لكل بائع برقم مستقل". This is the unit
/// sellers, couriers, commissions, returns and disputes all operate on.
model SellerOrder {
  id       String @id @default(uuid()) @db.Uuid
  number   String @unique
  orderId  String @map("order_id") @db.Uuid
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId String @map("seller_id") @db.Uuid
  seller   User   @relation("SellerSubOrders", fields: [sellerId], references: [id], onDelete: Restrict)

  status         SellerOrderStatus @default(NEW)
  fulfilmentMode FulfilmentMode    @default(PLATFORM_COURIER) @map("fulfilment_mode")

  currency      Currency
  itemsSubtotal Decimal  @map("items_subtotal") @db.Decimal(18, 4)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(18, 4)
  shippingCost  Decimal  @default(0) @map("shipping_cost") @db.Decimal(18, 4)

  /// Q50 — commission is charged on the POST-discount item total.
  commissionBase   Decimal @map("commission_base") @db.Decimal(18, 4)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(18, 4)
  sellerNet        Decimal @map("seller_net") @db.Decimal(18, 4)

  /// Q24 P1 — earnings stay escrowed until the return window closes, and any
  /// open dispute blocks release (Q107 P2).
  escrowReleaseAt DateTime? @map("escrow_release_at")
  escrowReleased  Boolean   @default(false) @map("escrow_released")

  confirmedAt DateTime? @map("confirmed_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  closedAt    DateTime? @map("closed_at")

  cancellationReason String? @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items            OrderItem[]
  events           OrderEvent[]
  reservations     InventoryReservation[]
  shipment         Shipment?
  returns          ReturnRequest[]
  dispute          Dispute?
  chats            Chat[]
  commissionLedger CommissionLedger?
  invoices         Invoice[]

  @@index([sellerId, status])
  @@index([orderId])
  @@index([escrowReleased, escrowReleaseAt])
  @@index([status, createdAt])
  @@map("seller_orders")
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  sellerOrderId String      @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  offerId String?      @map("offer_id") @db.Uuid
  offer   SellerOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String? @map("variant_id") @db.Uuid

  // Immutable snapshots — historical orders must survive catalog edits.
  titleSnapshot   String  @map("title_snapshot")
  imageSnapshot   String? @map("image_snapshot")
  variantSnapshot String? @map("variant_snapshot")
  sellerSnapshot  String  @map("seller_snapshot")

  currency     Currency
  unitPrice    Decimal  @map("unit_price") @db.Decimal(18, 4)
  unitDiscount Decimal  @default(0) @map("unit_discount") @db.Decimal(18, 4)
  quantity     Int      @default(1)
  lineTotal    Decimal  @map("line_total") @db.Decimal(18, 4)

  /// Q30 — made-to-order payload: engraved text, uploaded artwork, due date.
  customisation Json?

  returnItems ReturnItem[]

  /// The content tags this delivered line justifies. See
  /// `CommerceContentProductTag.basis`.
  contentProductTags CommerceContentProductTag[]

  /// At most one — a delivered line becomes at most one closet piece. Prisma
  /// still models the far side of a unique foreign key as a list.
  closetItems ClosetItem[]

  @@index([sellerOrderId])
  @@index([productId])
  /// Sales per offer, and the scan a seller's listing deletion would
  /// otherwise force over every line ever sold.
  @@index([offerId])
  @@map("order_items")
}

/// Append-only timeline. Attached to the parent for checkout/payment events
/// and to a sub-order for fulfilment events.
model OrderEvent {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String?      @map("order_id") @db.Uuid
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId String?      @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  actorId     String?  @map("actor_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([sellerOrderId, createdAt])
  @@map("order_events")
}

model CartItem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The cart holds a SELLER'S OFFER, not a bare product — price, stock and
  /// currency all belong to the offer.
  offerId String      @map("offer_id") @db.Uuid
  offer   SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  offerVariantId String?             @map("offer_variant_id") @db.Uuid
  offerVariant   SellerOfferVariant? @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)

  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, offerId, offerVariantId])
  @@index([userId])
  /// From the offer's side: who is holding this in a basket, and the cascade
  /// when a seller withdraws the listing.
  @@index([offerId])
  @@index([offerVariantId])
  @@map("cart_items")
}

model GuestCartItem {
  id             String       @id @default(uuid()) @db.Uuid
  guestSessionId String       @map("guest_session_id") @db.Uuid
  guestSession   GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  offerId String      @map("offer_id") @db.Uuid
  offer   SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  offerVariantId String?             @map("offer_variant_id") @db.Uuid
  offerVariant   SellerOfferVariant? @relation(fields: [offerVariantId], references: [id], onDelete: SetNull)

  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guestSessionId, offerId, offerVariantId])
  @@index([guestSessionId])
  @@index([offerId])
  @@index([offerVariantId])
  @@map("guest_cart_items")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method         PaymentMethodType
  status         PaymentStatus     @default(PENDING)
  currency       Currency          @default(SYP)
  amount         Decimal           @db.Decimal(18, 4)
  /// Q30/Q54 P1 — deposit or instalment support: what has actually been
  /// captured so far, so a partial payment is representable.
  capturedAmount Decimal           @default(0) @map("captured_amount") @db.Decimal(18, 4)
  refundedAmount Decimal           @default(0) @map("refunded_amount") @db.Decimal(18, 4)

  transactionRef String?   @unique @map("transaction_ref")
  providerRef    String?   @map("provider_ref")
  failureReason  String?   @map("failure_reason")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  transactions PaymentTransaction[]

  @@index([status])
  @@map("payments")
}

model PaymentTransaction {
  id        String        @id @default(uuid()) @db.Uuid
  paymentId String        @map("payment_id") @db.Uuid
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event     String // initiated | succeeded | failed | refunded
  status    PaymentStatus
  currency  Currency
  amount    Decimal       @db.Decimal(18, 4)
  message   String?
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

/// One order's cash-on-delivery risk assessment, kept forever.
///
/// Written before the sellers are told anything, and never updated except to
/// record how the assurance it demanded turned out. Three reasons it is a row
/// rather than a number computed on demand:
///
/// - The score is only meaningful next to the facts it was computed from. Six
///   months later the customer has a different history, and re-deriving "why
///   was she asked for a code in March" would produce a different answer than
///   the one she was actually given.
/// - `outcome` closes the loop. A parcel that was scored 81 and then refused
///   is the only evidence that says whether the weights are any good, and
///   without the pairing the engine can never be told it is wrong.
/// - A decision that added friction to a woman's checkout is a decision
///   somebody has to be able to answer for.
model CodRiskAssessment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null on a guest checkout — the assessment still happens, and weighs the
  /// absence of an account as its own signal.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 0–100, and 0–1. `confidence` says how much of the score came from her own
  /// delivery history rather than from the platform's opening assumption.
  score      Decimal @db.Decimal(5, 2)
  confidence Decimal @db.Decimal(4, 2)

  tier      CodRiskTier
  assurance CodAssurance
  state     CodAssuranceState @default(NOT_REQUIRED)

  /// Every factor, its points, its evidence and the raw counts behind it —
  /// the audit trail for one decision, frozen at the moment it was made.
  factors Json

  /// Hard rules that fired, e.g. `first_order_above_threshold`. A rule can
  /// only ever raise the assurance, so this list explains any gap between the
  /// score's tier and the assurance actually demanded.
  ruleCodes String[] @map("rule_codes")

  /// The value the courier would have carried, in USD at the order's own
  /// frozen rate — the figure the "loss avoided" report sums.
  exposureUsd Decimal @map("exposure_usd") @db.Decimal(18, 4)

  /// The confirmation challenge sent for `ORDER_CONFIRMATION`, if any.
  otpRequestId String? @map("otp_request_id") @db.Uuid

  satisfiedAt DateTime? @map("satisfied_at")
  expiresAt   DateTime? @map("expires_at")

  /// How the parcel actually ended: `delivered`, `refused`, `failed`,
  /// `cancelled`, or null while it is still moving. Written by the delivery
  /// workflow, and the only column that makes the weights falsifiable.
  observedOutcome String?   @map("observed_outcome")
  observedAt      DateTime? @map("observed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tier, createdAt])
  @@index([state, expiresAt])
  @@index([userId, createdAt])
  @@index([observedOutcome, createdAt])
  @@map("cod_risk_assessments")
}

// ─────────────────── Returns, exchanges, disputes ───────────────────

/// Q56 P1 — 7-day window; the seller bears the return leg when at fault, the
/// customer bears it on a change of mind; sensitive categories are excluded.
model ReturnRequest {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique
  sellerOrderId String      @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  requestedById String      @map("requested_by_id") @db.Uuid

  reason     ReturnReason
  reasonNote String?          @map("reason_note")
  status     ReturnStatus     @default(REQUESTED)
  resolution ReturnResolution @default(NONE)

  shippingBorneBy ReturnCostBearer? @map("shipping_borne_by")

  currency     Currency
  refundAmount Decimal? @map("refund_amount") @db.Decimal(18, 4)

  /// Uploaded photo evidence.
  evidence       Json?
  windowClosesAt DateTime  @map("window_closes_at")
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  items ReturnItem[]

  @@index([sellerOrderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id          String        @id @default(uuid()) @db.Uuid
  returnId    String        @map("return_id") @db.Uuid
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String        @map("order_item_id") @db.Uuid
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int           @default(1)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

/// Q107 P2 — support triages, admin decides; the amount is frozen meanwhile;
/// decision within 3 business days, extendable to 7; one appeal allowed.
model Dispute {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique
  sellerOrderId String      @unique @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  openedById String        @map("opened_by_id") @db.Uuid
  status     DisputeStatus @default(OPEN)
  subject    String

  currency     Currency
  frozenAmount Decimal  @map("frozen_amount") @db.Decimal(18, 4)

  dueAt        DateTime  @map("due_at")
  extendedTo   DateTime? @map("extended_to")
  appealUsed   Boolean   @default(false) @map("appeal_used")
  decisionNote String?   @map("decision_note")
  decidedById  String?   @map("decided_by_id") @db.Uuid
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages DisputeMessage[]

  @@index([status, dueAt])
  @@map("disputes")
}

model DisputeMessage {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  body       String
  evidence   Json?
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

// ─────────────────────── Shipping operations ───────────────────────

/// Q53/Q54 — admin-managed zones with a city-centre / rural split, and a
/// floor+ceiling inside which the seller sets their own fee.
model ShippingZone {
  id          String  @id @default(uuid()) @db.Uuid
  governorate String
  /// Null = the whole governorate.
  district    String?
  isRural     Boolean @default(false) @map("is_rural")

  currency   Currency @default(SYP)
  baseFee    Decimal  @map("base_fee") @db.Decimal(18, 4)
  minFee     Decimal  @map("min_fee") @db.Decimal(18, 4)
  maxFee     Decimal  @map("max_fee") @db.Decimal(18, 4)
  expressFee Decimal? @map("express_fee") @db.Decimal(18, 4)

  /// Q61/Q62 — same-day inside a city, 1-2 days between governorates.
  etaHoursMin Int @map("eta_hours_min")
  etaHoursMax Int @map("eta_hours_max")

  supportsPickupPoint Boolean @default(false) @map("supports_pickup_point")
  isActive            Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@unique([governorate, district, isRural])
  @@index([isActive])
  @@map("shipping_zones")
}

model Courier {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("CourierAccount", fields: [userId], references: [id], onDelete: SetNull)

  kind         CourierKind @default(PLATFORM_STAFF)
  displayName  String      @map("display_name")
  phone        String
  companyName  String?     @map("company_name")
  governorates String[]
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  shipments      Shipment[]
  settlements    CashSettlement[]
  ledgerAccounts LedgerAccount[]  @relation("LedgerAccounts")

  /// Set when this carrier is also reachable as a dispatch provider — the
  /// in-house fleet is modelled as one provider among the external companies,
  /// so the dispatch path has no special case for it.
  deliveryProviderAccount DeliveryProviderAccount?

  @@index([isActive])
  @@map("couriers")
}

/// Q55 — what the courier app writes back: status, collected cash, proof
/// photo, failure reason, geo-stamp.
model Shipment {
  id            String      @id @default(uuid()) @db.Uuid
  trackingCode  String      @unique @map("tracking_code")
  sellerOrderId String      @unique @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  courierId String?  @map("courier_id") @db.Uuid
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  zoneId String?       @map("zone_id") @db.Uuid
  zone   ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  status ShipmentStatus @default(CREATED)

  currency        Currency @default(SYP)
  codAmount       Decimal? @map("cod_amount") @db.Decimal(18, 4)
  collectedAmount Decimal? @map("collected_amount") @db.Decimal(18, 4)

  /// Q64 — the customer may choose a delivery slot or defer the date.
  scheduledFor DateTime? @map("scheduled_for")
  isExpress    Boolean   @default(false) @map("is_express")

  pickedUpAt    DateTime? @map("picked_up_at")
  deliveredAt   DateTime? @map("delivered_at")
  proofImageUrl String?   @map("proof_image_url")
  recipientNote String?   @map("recipient_note")

  failureReason DeliveryFailureReason? @map("failure_reason")
  failureNote   String?                @map("failure_note")
  attemptCount  Int                    @default(0) @map("attempt_count")

  /// Q44 P1 — proxy number shown to the seller when masking is enabled.
  maskedPhone String? @map("masked_phone")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events ShipmentEvent[]

  /// The carrier this parcel was handed to, when it left the platform's own
  /// fleet. Absent for a parcel nobody has dispatched yet.
  dispatch DeliveryDispatch?

  @@index([courierId, status])
  @@index([status])
  @@index([zoneId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  latitude   Float?
  longitude  Float?
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

/// Q56 — daily reconciliation of the cash couriers collected.
model CashSettlement {
  id         String   @id @default(uuid()) @db.Uuid
  courierId  String   @map("courier_id") @db.Uuid
  courier    Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  periodDate DateTime @map("period_date") @db.Date

  currency  Currency  @default(SYP)
  expected  Decimal   @db.Decimal(18, 4)
  collected Decimal   @db.Decimal(18, 4)
  variance  Decimal   @db.Decimal(18, 4)
  settledAt DateTime? @map("settled_at")

  settledById String?  @map("settled_by_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courierId, periodDate])
  @@index([periodDate])
  @@map("cash_settlements")
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("search_history")
}

/// Words that mean the same garment.
///
/// Arabic retail has several words for one thing and a customer uses whichever
/// she grew up with: شنطة and حقيبة, جزمة and حذاء, تنورة and جيبة. Folding
/// (`reem_search_key`) makes spellings of one word agree; it cannot make two
/// different words agree, and no amount of typo tolerance will — شنطة and حقيبة
/// share no letters. That has to be told to the system.
///
/// This is a table rather than a constant because the platform already knows
/// which words are missing: `TrendSignalService` records every search that
/// returned nothing. A merchandiser reading that list should be able to say
/// "شنطة means حقيبة" and have it take effect, without a deploy.
model SearchSynonymGroup {
  id   String  @id @default(uuid()) @db.Uuid
  /// Why this group exists, for whoever inherits it.
  note String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("SynonymGroupsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  terms SearchSynonymTerm[]

  @@index([isActive])
  @@index([createdById])
  @@map("search_synonym_groups")
}

model SearchSynonymTerm {
  id      String             @id @default(uuid()) @db.Uuid
  groupId String             @map("group_id") @db.Uuid
  group   SearchSynonymGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// As a merchandiser typed it, so the console can show her own words back.
  term String

  /// The same word through `reem_search_key`, which is what a query is
  /// actually compared against. Stored rather than derived at read time
  /// because expansion happens on every search.
  ///
  /// Unique across ALL groups, deliberately: a word belongs to one meaning.
  /// Letting شنطة sit in both a handbag group and a suitcase group would make
  /// expansion transitive — every search for a handbag would start returning
  /// luggage — and there would be no rule for which group wins.
  termKey String @unique @map("term_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([groupId])
  @@map("search_synonym_terms")
}

/// A staff decision about two listings that look like the same garment.
///
/// Detection is a query, not a table — similarity is recomputed from the
/// catalogue as it stands. What has to persist is the *answer*, so a pair a
/// merchandiser has already looked at stops coming back. Without this the
/// duplicate queue re-serves the same two dresses every morning forever, and
/// the queue stops being read.
model ProductDuplicateVerdict {
  id String @id @default(uuid()) @db.Uuid

  /// Ordered by uuid so a pair is stored once however it was found.
  leftProductId  String  @map("left_product_id") @db.Uuid
  leftProduct    Product @relation("DuplicateLeft", fields: [leftProductId], references: [id], onDelete: Cascade)
  rightProductId String  @map("right_product_id") @db.Uuid
  rightProduct   Product @relation("DuplicateRight", fields: [rightProductId], references: [id], onDelete: Cascade)

  verdict DuplicateVerdict
  note    String?

  decidedById String?  @map("decided_by_id") @db.Uuid
  decidedBy   User?    @relation("DuplicateVerdicts", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime @default(now()) @map("decided_at")

  @@unique([leftProductId, rightProductId])
  @@index([rightProductId])
  @@index([decidedById])
  @@map("product_duplicate_verdicts")
}

/// A reading the trust engine took, and what a person did about it.
///
/// One table for reviews, customers and boutiques rather than three, because
/// the console works them the same way: a score, the evidence behind it, and a
/// decision. Splitting them would mean three queues, and the third one never
/// gets opened.
///
/// The row is a *reading*, not a verdict — nothing in this module hides a
/// review or freezes an account on its own. Accusing a woman of dishonesty is
/// a person's decision, and `status` is where that person's answer is written.
model TrustSignal {
  id String @id @default(uuid()) @db.Uuid

  subject   TrustSubject
  /// The review, customer or seller this reading is about. Not a foreign key:
  /// it points at three different tables depending on `subject`, and a
  /// polymorphic FK is not a thing PostgreSQL has. The reader joins on
  /// `subject` + `subjectId`.
  subjectId String       @map("subject_id") @db.Uuid

  /// 0–100, from the kernel.
  score Float
  band  TrustBand

  /// Every reason that made up the score: `[{ code, weight, ar }]`. Stored
  /// rather than recomputed so the queue shows the evidence as it stood when
  /// the reading was taken — a moderator looking at a week-old flag needs to
  /// see what triggered it, not what would trigger it today.
  reasons Json

  status TrustSignalStatus @default(OPEN)

  /// What the person decided, in their own words.
  note         String?
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedBy   User?     @relation("TrustSignalsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One open reading per subject: a re-scan updates the row it already has
  /// rather than stacking a new flag on every sweep, which is how a queue
  /// becomes ten thousand copies of the same twelve cases.
  @@unique([subject, subjectId])
  @@index([status, band, score])
  @@index([subject, band])
  @@index([resolvedById])
  @@map("trust_signals")
}

/// A re-engagement message the platform has already sent.
///
/// This table is the whole difference between a reminder and a nuisance. An
/// abandoned-basket nudge with no record of having been sent goes out on every
/// run of the job — every hour, to the same woman, about the same dress —
/// until she uninstalls the app. What it costs to prevent that is one row.
///
/// `reference` is what the touch was *about*, and it is what makes "once" mean
/// the right thing in each case. For a basket it is a fingerprint that changes
/// when she adds or removes anything, so a new basket earns a new reminder and
/// the same basket never does. For a win-back it is the month, so she hears
/// from the platform at most once in it.
model ReengagementTouch {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation("ReengagementTouches", fields: [userId], references: [id], onDelete: Cascade)

  kind      ReengagementKind
  reference String

  /// What she was in when this went out, for measuring whether it worked.
  stage String?

  sentAt DateTime @default(now()) @map("sent_at")

  /// Set when an order arrives from her after this touch and before the next.
  /// Null is not "it failed" — it is "not yet", and the difference matters
  /// when reading the numbers a week later.
  convertedAt DateTime? @map("converted_at")

  @@unique([userId, kind, reference])
  @@index([kind, sentAt])
  @@map("reengagement_touches")
}

/// A window in which some listings are cheaper.
///
/// Kept apart from `Coupon` because it answers a different question. A coupon
/// is something a customer *has*; a flash sale is something a listing *is* —
/// it needs no code, applies to everyone, and shows on the product card before
/// anybody has reached a basket. Modelling one as the other would mean either
/// minting a coupon nobody types or hiding the price until checkout.
///
/// Who pays for the discount is recorded on each line rather than on the sale,
/// because a single sale routinely mixes both: a boutique cutting her own
/// margin on two pieces while the platform funds a third to fill the page.
/// Settlement already reads `fundedBySeller` for coupons and does the same
/// thing here — commission on what she actually gave away, marketing expense
/// on what the platform did.
model FlashSale {
  id    String  @id @default(uuid()) @db.Uuid
  title String
  note  String?

  status FlashSaleStatus @default(DRAFT)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// The boutique running it, or null for a platform-wide sale.
  sellerId String? @map("seller_id") @db.Uuid
  seller   User?   @relation("FlashSalesRun", fields: [sellerId], references: [id], onDelete: Cascade)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("FlashSalesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items FlashSaleItem[]

  @@index([status, startsAt, endsAt])
  @@index([sellerId, status])
  @@index([createdById])
  @@map("flash_sales")
}

model FlashSaleItem {
  id     String    @id @default(uuid()) @db.Uuid
  saleId String    @map("sale_id") @db.Uuid
  sale   FlashSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  offerId String      @map("offer_id") @db.Uuid
  offer   SellerOffer @relation("FlashSaleOffers", fields: [offerId], references: [id], onDelete: Cascade)

  /// What it costs during the window. An absolute price, not a percentage:
  /// a percentage recomputed at checkout can disagree with the number she was
  /// shown on the card, and the number she was shown is the one she agreed to.
  salePrice Decimal  @map("sale_price") @db.Decimal(18, 4)
  currency  Currency @default(SYP)

  /// The price it was, frozen when the line was created, so a card can show
  /// what she is saving without trusting a `price` the seller may have edited
  /// upward the same morning.
  compareAtPrice Decimal @map("compare_at_price") @db.Decimal(18, 4)

  /// How many units may go at this price. Null means "all the stock there is".
  ///
  /// When set, it is claimed the same way stock is — conditionally, inside the
  /// checkout transaction — because a doorbuster with no cap on the discount
  /// is a doorbuster that sells the whole shelf at a loss.
  quantityCap  Int? @map("quantity_cap")
  quantitySold Int  @default(0) @map("quantity_sold")

  /// Q49 again: whoever created the discount absorbs it.
  fundedBySeller Boolean @default(true) @map("funded_by_seller")

  createdAt DateTime @default(now()) @map("created_at")

  /// One price per offer per sale.
  @@unique([saleId, offerId])
  @@index([offerId])
  @@map("flash_sale_items")
}

/// A boutique paying to be surfaced.
///
/// A flat fee for a window, not an auction and not cost-per-click, and that is
/// a deliberate limit rather than a first step. An auction needs a bidding
/// engine nobody here can tune yet; cost-per-click needs click-fraud defences,
/// and charging real money against a counter anybody can inflate by tapping is
/// how an ad product becomes a liability. A fixed price for a fixed window can
/// be billed honestly on the day it starts, and it can be audited.
///
/// Impressions and clicks are still counted — a seller has to be able to see
/// what she bought — but they are reporting, not billing. Nothing about the
/// money depends on a number a phone can send.
model ProductPromotion {
  id String @id @default(uuid()) @db.Uuid

  offerId String      @map("offer_id") @db.Uuid
  offer   SellerOffer @relation("PromotedOffers", fields: [offerId], references: [id], onDelete: Cascade)

  sellerId String @map("seller_id") @db.Uuid
  seller   User   @relation("PromotionsBought", fields: [sellerId], references: [id], onDelete: Cascade)

  placement PromotionPlacement

  /// What she agreed to pay for the window, charged once when it starts.
  feeAmount   Decimal  @map("fee_amount") @db.Decimal(18, 4)
  feeCurrency Currency @default(SYP) @map("fee_currency")

  status PromotionStatus @default(PENDING)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// The journal entry that took the fee. Null until it is charged, which is
  /// also what makes charging idempotent: a promotion that already carries a
  /// reference is not billed twice.
  chargeReference String?   @unique @map("charge_reference")
  chargedAt       DateTime? @map("charged_at")

  /// Reporting only. See the note above.
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, startsAt, endsAt])
  @@index([sellerId, status])
  @@index([offerId])
  @@map("product_promotions")
}

/// A change being tried on some customers and not others.
///
/// Assignment is *computed*, not stored: a hash of the experiment key and the
/// subject decides the variant, so the same woman sees the same thing on her
/// phone and her sister's laptop without a lookup, and a busy experiment costs
/// no writes on the read path. The rows below record what was *shown* and what
/// happened afterwards, which is a different question from what she was
/// assigned — a variant nobody ever reached tells you nothing, and counting
/// assignments as exposures is the commonest way an experiment reports a
/// result it did not measure.
model Experiment {
  id  String @id @default(uuid()) @db.Uuid
  /// Stable and human — it goes in the hash, so renaming it re-randomises
  /// everybody and invalidates the run. Changing it is starting a new test.
  key String @unique

  name       String
  hypothesis String?

  status ExperimentStatus @default(DRAFT)

  /// `[{ "key": "control", "weight": 50 }, { "key": "wider_cards", "weight": 50 }]`
  variants Json

  /// What counts as success. Free text the analyst chooses, matched against
  /// the `metric` recorded on a conversion.
  metric String

  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ExperimentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events ExperimentEvent[]

  @@index([status, startsAt])
  @@index([createdById])
  @@map("experiments")
}

/// One thing that happened to one subject inside one experiment.
///
/// Exposures and conversions in one table rather than two, because they are
/// the same shape and every question worth asking joins them. The unique key
/// makes both idempotent: a screen that renders twice records one exposure,
/// and a customer who reloads a confirmation page converts once.
model ExperimentEvent {
  id           String     @id @default(uuid()) @db.Uuid
  experimentId String     @map("experiment_id") @db.Uuid
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  /// The customer, or a guest session. Not a foreign key: an experiment that
  /// could only measure signed-in women would miss the half of the funnel
  /// where most of the drop-off is.
  subjectKey String @map("subject_key")

  /// The variant she was actually shown, stored rather than recomputed, so a
  /// later change to the weights cannot silently rewrite history.
  variant String

  kind ExperimentEventKind

  /// For a conversion: which metric. Empty string for an exposure.
  ///
  /// Not nullable, and that is the whole reason the idempotency below works.
  /// PostgreSQL treats NULLs as *distinct* in a unique index, so a nullable
  /// column here admitted three identical exposure rows for one subject and
  /// the "one exposure per screen" guarantee was silently no guarantee at
  /// all. The same trap `LedgerAccount.ownerKey` exists to avoid.
  metric String @default("")

  /// The value of the conversion, when it has one — an order total, say.
  value    Decimal?  @db.Decimal(18, 4)
  currency Currency?

  occurredAt DateTime @default(now()) @map("occurred_at")

  /// One exposure and one conversion-per-metric per subject.
  @@unique([experimentId, subjectKey, kind, metric])
  @@index([experimentId, variant, kind])
  @@map("experiment_events")
}

/// What the platform has worked out about one customer.
///
/// A cache, refreshed on a sweep, and never the source of truth — every figure
/// is derived from orders and events that remain exactly where they were.
/// It exists because the readings feed hot paths: a notification job deciding
/// whom to reach, a ranking deciding what to show her. Recomputing four scores
/// from a hundred thousand events on each of those is not a trade worth making,
/// and a stale-by-a-day score is a far smaller error than the one it replaces.
///
/// `computedAt` is on the row rather than implied, so a screen can say how old
/// the reading is instead of presenting yesterday's as today's.
model CustomerProfile {
  userId String @id @map("user_id") @db.Uuid
  user   User   @relation("CustomerProfile", fields: [userId], references: [id], onDelete: Cascade)

  /// 0–100, with the reasons behind each stored beside it. The reasons are
  /// the point: a score nobody can explain is a score nobody acts on.
  propensityScore Float  @map("propensity_score")
  propensityBand  String @map("propensity_band")

  churnScore  Float  @map("churn_score")
  churnBand   String @map("churn_band")
  /// Her own average days between orders. Null below two orders.
  cadenceDays Float? @map("cadence_days")

  /// Net of refunds, and projected over `valueHorizonDays`.
  realisedValue    Decimal  @map("realised_value") @db.Decimal(18, 4)
  projectedValue   Decimal  @map("projected_value") @db.Decimal(18, 4)
  valueHorizonDays Int      @map("value_horizon_days")
  currency         Currency @default(SYP)

  /// The hour she is most often active, 0–23. Null when too little is known —
  /// a "best hour" from four app opens is a random hour with an excuse.
  bestContactHour Int? @map("best_contact_hour")

  /// `{ propensity: [...], churn: [...] }` — every signal, in Arabic.
  signals Json

  /// False when the history behind the scores is too thin to spend money on.
  confident Boolean @default(false)

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([churnBand, churnScore])
  @@index([propensityBand, propensityScore])
  @@index([computedAt])
  @@map("customer_profiles")
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  /// Stopped, and readable. Assignment returns the control from here on, so a
  /// half-rolled-out change does not keep running because somebody forgot.
  STOPPED
}

enum ExperimentEventKind {
  /// She was shown the variant.
  EXPOSURE
  /// She did the thing the experiment is about.
  CONVERSION
}

enum PromotionPlacement {
  /// A labelled slot above organic search results.
  SEARCH
  /// A labelled slot on a category page.
  CATEGORY
}

enum PromotionStatus {
  /// Bought, not yet charged or shown.
  PENDING
  /// Charged and live inside its window.
  ACTIVE
  /// Stopped by the seller or by staff. The fee is not refunded here — that
  /// is a decision for a person, through the normal refund path.
  PAUSED
  ENDED
  /// The fee could not be taken. Never shown.
  UNPAID
}

enum FlashSaleStatus {
  DRAFT
  /// Scheduled and visible; the window decides whether it is live right now.
  ACTIVE
  /// Stopped early. The window may still be open; the price is not.
  PAUSED
  ENDED
}

enum ReengagementKind {
  /// She filled a basket and walked away.
  ABANDONED_CART
  /// She used to buy and stopped.
  WIN_BACK
}

enum TrustSubject {
  /// One review, scored for whether it was bought.
  REVIEW
  /// A customer, scored for returns and refunds.
  CUSTOMER_REFUNDS
  /// A customer, scored for looking like several people.
  CUSTOMER_IDENTITY
  /// A boutique, scored for conduct rather than performance. `SellerHealth`
  /// already answers "is she selling well"; this answers the different
  /// question of whether the platform is carrying a risk by listing her.
  SELLER_CONDUCT
}

enum TrustBand {
  CLEAR
  WATCH
  SUSPECT
}

enum TrustSignalStatus {
  /// Nobody has looked yet.
  OPEN
  /// A person looked and agreed.
  CONFIRMED
  /// A person looked and disagreed. The subject is not re-flagged for the
  /// same evidence, which is what stops the queue re-serving settled cases.
  DISMISSED
}

enum DuplicateVerdict {
  /// The same garment listed twice — merge or delist one.
  DUPLICATE
  /// They only read alike. Never offer this pair again.
  DISTINCT
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  /// Reached from the product side too: how many women saved this piece, and
  /// the cascade when a listing is removed. The unique above leads with
  /// `userId`, so it cannot answer either.
  @@index([productId])
  @@map("favorites")
}

model GuestSavedItem {
  id             String             @id @default(uuid()) @db.Uuid
  guestSessionId String             @map("guest_session_id") @db.Uuid
  guestSession   GuestSession       @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  type           GuestSavedItemType
  productId      String?            @map("product_id") @db.Uuid
  product        Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId       String?            @map("seller_id") @db.Uuid
  seller         User?              @relation("GuestSavedSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  /// The social content she saved. Named for the platform it now points at;
