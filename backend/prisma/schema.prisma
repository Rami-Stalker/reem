  VERIFIED
  EXPIRED
  LOCKED
}

/// Where the private half of a device key lives. Recorded from day one so the
/// eventual move to Keystore/Secure Enclave is a data migration rather than a
/// schema change — and so a fleet-wide report can say how much of the estate is
/// actually hardware-backed instead of assuming it.
/// How strongly the current session has been authenticated.
///
/// AAL1 is "signed in". AAL2 additionally requires a fresh device proof, so the
/// request demonstrably came from the enrolled handset. AAL3 requires a second
/// factor consumed within the last ten minutes.
enum AssuranceLevel {
  AAL1
  AAL2
  AAL3
}

/// What satisfied a step-up. Deliberately not SIM-only: an assurance ladder
