  averageRating             Float                   @default(0) @map("average_rating")
  reviewsCount              Int                     @default(0) @map("reviews_count")
  verifiedReviewsCount      Int                     @default(0) @map("verified_reviews_count")
  performanceScore          Float                   @default(0) @map("performance_score")
  customerSatisfactionScore Float                   @default(0) @map("customer_satisfaction_score")
  /// Median hours to a first reply, scored — or **null when she has never
  /// been messaged**.
  ///
  /// Nullable on purpose. This column used to be a non-null float that
  /// `ReputationService` filled with the literal `90` for every seller on the
  /// platform, and the demo seed filled with an invented figure, so a shop
  /// with no conversations at all still showed a responsiveness score on its
  /// own dashboard. Seller Intelligence measures it from real messages; where
  /// there are none, the honest value is "nothing to measure", and only a
  /// nullable column can say that. Readers must render null as unmeasured
  /// rather than substituting a number.
  responseScore             Float?                  @map("response_score")
  fulfillmentScore          Float                   @default(0) @map("fulfillment_score")
  topSellerTier             SellerProgramTier       @default(STANDARD) @map("top_seller_tier")
  trustedStatus             TrustVerificationStatus @default(PENDING) @map("trusted_status")
  calculatedAt              DateTime                @default(now()) @map("calculated_at")

