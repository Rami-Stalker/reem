model MessageAttachment {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      MessageKind
  url       String

  /// The upload this points at, when it is one of ours.
  ///
  /// The URL alone cannot answer "may this person open it": chat media is
  /// private, so the reader is whoever is in the conversation, and finding
  /// that from a URL means a suffix match across every attachment ever sent.
  /// This is the indexed answer. Null for anything not uploaded through
  /// `MediaService` — the demo dataset's external links, a future integration.
  ///
  /// `SetNull` rather than cascade: if an asset is ever deleted the message
  /// must survive as a record of what was said, holding a dead link rather
  /// than vanishing from the conversation.
  mediaAssetId String?     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mimeType     String?     @map("mime_type")
  fileName     String?     @map("file_name")
  sizeBytes    Int?        @map("size_bytes")
  width        Int?
  height       Int?
  durationMs   Int?        @map("duration_ms")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([messageId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

