enum AnalyticsEventType {
  APP_OPEN
  PRODUCT_VIEW
  PRODUCT_SEARCH
  CART_ADD
  CHECKOUT_START
  ORDER_PLACED
  PAYMENT_SUCCESS
  SELLER_VIEW
  CAMPAIGN_OPEN
  CAMPAIGN_CLICK
  CUSTOM
