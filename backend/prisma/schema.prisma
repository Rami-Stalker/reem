  platformFee   Decimal          @default(0) @map("platform_fee") @db.Decimal(18, 4)
  net           Decimal          @db.Decimal(18, 4)
  status        CommissionStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  paidAt        DateTime?        @map("paid_at")

  payoutItems SellerPayoutLedger[]

  @@index([sellerOrderId])
  @@index([sellerId, status])
  @@index([ruleId])
  @@map("commission_ledgers")
}

model SellerPayout {
