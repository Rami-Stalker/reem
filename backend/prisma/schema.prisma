// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  name                       String
  username                   String    @unique
  email                      String?   @unique
  phone                      String?   @unique
  passwordHash               String?   @map("password_hash")
  bio                        String?
  imageUrl                   String?   @map("image_url")
  location                   String?
  isVerified                 Boolean   @default(false) @map("is_verified")
  role                       UserRole  @default(CUSTOMER)
  mfaEnabled                 Boolean   @default(false) @map("mfa_enabled")
  deviceVerificationRequired Boolean   @default(true) @map("device_verification_required")
  failedLoginCount           Int       @default(0) @map("failed_login_count")
  lockedUntil                DateTime? @map("locked_until")
  lastLoginAt                DateTime? @map("last_login_at")
  disabledAt                 DateTime? @map("disabled_at")
  points                     Int       @default(0)
  lifetimePoints             Int       @default(0) @map("lifetime_points")
  tier                       String    @default("Bronze")
  followersCount             Int       @default(0) @map("followers_count")
  followingCount             Int       @default(0) @map("following_count")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  refreshTokens             RefreshToken[]
  sessions                  Session[]
  devices                   Device[]
  otpRequests               OtpRequest[]
  linkedAccounts            LinkedAccount[]
  roleAssignments           UserRoleAssignment[]
  sellerVerification        SellerVerification?
  auditLogs                 AuditLog[]
  loginAttempts             LoginAttempt[]
  pushTokens                PushToken[]
  supportTickets            SupportTicket[]
  supportMessages           SupportMessage[]
  notificationDeliveries    NotificationDelivery[]
  products                  Product[]                  @relation("SellerProducts")
  posts                     Post[]
  postLikes                 PostLike[]
  postSaves                 PostSave[]
  comments                  Comment[]
  stories                   Story[]
  storyViews                StoryView[]
  storyReactions            StoryReaction[]
  orders                    Order[]
  cartItems                 CartItem[]
  searchHistory             SearchHistory[]
  favorites                 Favorite[]
  sellerFavorites           SellerFavorite[]           @relation("UserSellerFavorites")
  savedByUsers              SellerFavorite[]           @relation("SavedSellers")
  postFavorites             PostFavorite[]
  wishlistCollections       WishlistCollection[]
  wishlistShares            WishlistShare[]
  addresses                 Address[]
  sentMessages              Message[]                  @relation("SentMessages")
  chatParticipants          ChatParticipant[]
  buyerChats                Chat[]                     @relation("BuyerChats")
  sellerChats               Chat[]                     @relation("SellerChats")
  messageReceipts           MessageReadReceipt[]
  blockedUsers              ChatBlock[]                @relation("ChatBlocker")
  blockedBy                 ChatBlock[]                @relation("ChatBlocked")
  chatReportsFiled          ChatReport[]               @relation("ChatReporter")
  chatReportsAgainst        ChatReport[]               @relation("ChatReportedUser")
  presence                  UserPresence?
  analyticsEvents           AnalyticsEvent[]
  analyticsExports          AnalyticsExport[]
  productReviews            ProductReview[]            @relation("CustomerProductReviews")
  sellerReviewsWritten      SellerReview[]             @relation("CustomerSellerReviews")
  sellerReviewsReceived     SellerReview[]             @relation("SellerReviews")
  reviewModerationLogs      ReviewModerationLog[]
  sellerBadges              SellerBadge[]              @relation("SellerBadges")
  sellerReputation          SellerReputation?
  trustedSellerVerification TrustedSellerVerification?
  wishlistSellerItems       WishlistCollectionItem[]   @relation("WishlistItemSeller")
  aiInteractions            AiInteraction[]
  aiGenerations             AiGeneration[]
  commissionLedgers         CommissionLedger[]         @relation("SellerCommissionLedgers")
  sellerPayouts             SellerPayout[]             @relation("SellerPayouts")
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  paymentMethods            PaymentMethod[]
  pointsTransactions        PointsTransaction[]
  couponRedemptions         CouponRedemption[]
  coupons                   Coupon[]                   @relation("UserCoupons")
  referralCodes             ReferralCode[]             @relation("ReferralCodeOwner")
  referralsMade             Referral[]                 @relation("Referrer")
  referralsReceived         Referral[]                 @relation("ReferredUser")
  referralRewards           ReferralReward[]
  membership                MembershipAccount?
  cashbackEntries           CashbackLedger[]
  exclusiveOfferClaims      ExclusiveOfferClaim[]
  following                 Follow[]                   @relation("Follower")
  followers                 Follow[]                   @relation("Following")

  @@index([role])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// Directed follow edge: follower -> following.
model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  tokenFamily       String    @map("token_family")
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?   @map("session_id") @db.Uuid
  session           Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deviceId          String?   @map("device_id") @db.Uuid
  device            Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

model Session {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId                String?       @map("device_id") @db.Uuid
  device                  Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status                  SessionStatus @default(ACTIVE)
  ipAddress               String?       @map("ip_address")
  userAgent               String?       @map("user_agent")
  currentRefreshTokenHash String?       @map("current_refresh_token_hash")
  lastSeenAt              DateTime      @default(now()) @map("last_seen_at")
  expiresAt               DateTime      @map("expires_at")
  revokedAt               DateTime?     @map("revoked_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([userId, status])
  @@index([deviceId])
  @@map("sessions")
}

model Device {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String           @map("fingerprint_hash")
  name            String
  platform        String?
  appVersion      String?          @map("app_version")
  trustLevel      DeviceTrustLevel @default(UNVERIFIED) @map("trust_level")
  ipAddress       String?          @map("ip_address")
  userAgent       String?          @map("user_agent")
  verifiedAt      DateTime?        @map("verified_at")
  lastSeenAt      DateTime         @default(now()) @map("last_seen_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@unique([userId, fingerprintHash])
  @@index([userId, trustLevel])
  @@map("devices")
}

model OtpRequest {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([destination, purpose, status])
  @@index([userId])
  @@index([createdAt])
  @@map("otp_requests")
}

model LinkedAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  displayName    String?      @map("display_name")
  linkedAt       DateTime     @default(now()) @map("linked_at")
  lastUsedAt     DateTime?    @map("last_used_at")

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("linked_accounts")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String    @map("role_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_role_assignments")
}

model SellerVerification {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @unique @map("user_id") @db.Uuid
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          SellerVerificationStatus @default(PENDING)
  businessName    String                   @map("business_name")
  legalName       String                   @map("legal_name")
  taxId           String?                  @map("tax_id")
  documentUrls    Json                     @map("document_urls")
  rejectionReason String?                  @map("rejection_reason")
  reviewedBy      String?                  @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?                @map("reviewed_at")
  submittedAt     DateTime                 @default(now()) @map("submitted_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@map("seller_verifications")
}

model AuditLog {
  id        String        @id @default(uuid()) @db.Uuid
  actorId   String?       @map("actor_id") @db.Uuid
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  category  String
  outcome   String
  severity  AuditSeverity @default(INFO)
  ipAddress String?       @map("ip_address")
  userAgent String?       @map("user_agent")
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

model LoginAttempt {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  success   Boolean
  reason    String?
  ipAddress String?       @map("ip_address")
  userAgent String?       @map("user_agent")
  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  seller         User          @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String        @default("general")
  price          Float
  oldPrice       Float?        @map("old_price")
  stock          Int           @default(0)
  isAvailable    Boolean       @default(true) @map("is_available")
  isFeatured     Boolean       @default(false) @map("is_featured")
  showInFeed     Boolean       @default(true) @map("show_in_feed")
  status         ProductStatus @default(DRAFT)
  rating         Float         @default(0)
  reviewsCount   Int           @default(0) @map("reviews_count")
  viewsCount     Int           @default(0) @map("views_count")
  likesCount     Int           @default(0) @map("likes_count")
  ordersCount    Int           @default(0) @map("orders_count")
  favoritesCount Int           @default(0) @map("favorites_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  media                   ProductMedia[]
  variants                ProductVariant[]
  posts                   Post[]
  favorites               Favorite[]
  orderItems              OrderItem[]
  cartItems               CartItem[]
  chats                   Chat[]
  analyticsEvents         AnalyticsEvent[]
  wishlistCollectionItems WishlistCollectionItem[]
  reviews                 ProductReview[]
  aiInteractions          AiInteraction[]
  aiGenerations           AiGeneration[]

  @@index([sellerId])
  @@index([category])
  @@index([isFeatured])
  @@index([status])
  // Composite indexes for the discovery collection queries (status-gated sorts).
  @@index([status, createdAt])
  @@index([status, ordersCount])
  @@index([status, rating])
  @@index([status, favoritesCount])
  @@index([status, viewsCount])
  @@index([category, status, createdAt])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(image)
  sortOrder Int       @default(0) @map("sort_order")

  @@map("product_media")
}

model ProductVariant {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Float?
  stock      Int     @default(0)
  attributes Json?
  sortOrder  Int     @default(0) @map("sort_order")

  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

// ───────────────────────────── Social ─────────────────────────────

model Post {
  id            String   @id @default(uuid()) @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  caption       String
  likesCount    Int      @default(0) @map("likes_count")
  commentsCount Int      @default(0) @map("comments_count")
  sharesCount   Int      @default(0) @map("shares_count")
  savesCount    Int      @default(0) @map("saves_count")
  createdAt     DateTime @default(now()) @map("created_at")

  likes                   PostLike[]
  saves                   PostSave[]
  comments                Comment[]
  favorites               PostFavorite[]
  wishlistCollectionItems WishlistCollectionItem[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id     String @id @default(uuid()) @db.Uuid
  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_saves")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("comments")
}

model Story {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String    @map("media_url")
  mediaType MediaType @default(image) @map("media_type")
  link      String?
  expiresAt DateTime  @map("expires_at")
