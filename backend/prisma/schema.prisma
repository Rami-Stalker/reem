enum OtpPurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
  DEVICE_VERIFICATION
  ACCOUNT_LINKING
  /// Passwordless sign-in. The primary way into the product: she types her
  /// number, we send a code, the code is the credential. A password, where she
  /// has opted into one, only ever *shortens* this on a device the platform
  /// already knows.
  LOGIN
  /// Proof of control over the number currently on the account, demanded
  /// before it can be moved. The other half of the pair is a
  /// `PHONE_VERIFICATION` code on the incoming number.
  PHONE_CHANGE
  /// Sent to the number on file when a support-mediated recovery case is
  /// approved, so the real owner — who is still holding her SIM in every
  /// scenario except the one recovery exists for — can stop it.
  ACCOUNT_RECOVERY
}

/// Q47/Q48 P1 — WhatsApp is the primary channel; SMS needs a local provider.
enum OtpChannel {
  WHATSAPP
  SMS
  EMAIL
}

/// Q47/Q48 P1 — WhatsApp is the declared primary channel, SMS through a local
/// Syrian aggregator is the fallback that reaches a handset with mobile data
/// switched off, voice is the last automated resort, and the ops console is a
/// closed-beta stopgap that a human reads out loud.
enum OtpTransportKind {
  WHATSAPP_CLOUD
  SMS_GATEWAY
  VOICE
  OPS_CONSOLE
}

/// `SENT` means the provider accepted the message. `DELIVERED` means a receipt
/// said it reached the handset. The gap between those two is the dominant
/// Syrian failure mode — accepted, never delivered — and is what failover has
/// to react to.
enum OtpDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
  EXPIRED
}

enum OtpOutboxStatus {
  PENDING
  IN_FLIGHT
  AWAITING_RECEIPT
  DELIVERED
  EXHAUSTED
  CANCELLED
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

/// Where the private half of a device key lives. Recorded from day one so the
/// eventual move to Keystore/Secure Enclave is a data migration rather than a
/// schema change — and so a fleet-wide report can say how much of the estate is
/// actually hardware-backed instead of assuming it.
/// How strongly the current session has been authenticated.
///
/// AAL1 is "signed in". AAL2 additionally requires a fresh device proof, so the
/// request demonstrably came from the enrolled handset. AAL3 requires a second
/// factor consumed within the last ten minutes.
enum AssuranceLevel {
  AAL1
  AAL2
  AAL3
}

/// What satisfied a step-up. Deliberately not SIM-only: an assurance ladder
/// whose every rung is another code to the same SIM is defeated entirely by
/// possession of that SIM, which is the attack it is supposed to stop.
enum StepUpMethod {
  OTP
  TOTP
  RECOVERY_CODE
}

enum DeviceKeyStorage {
  SOFTWARE
  HARDWARE
  BROWSER_NONEXTRACTABLE
}

enum DeviceTrustLevel {
  UNVERIFIED
