model Chat {
  id            String          @id @default(uuid()) @db.Uuid
  type          ChatContextType @default(DIRECT)
  productId     String?         @map("product_id") @db.Uuid
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerOrderId String?         @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder?    @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  buyerId       String?         @map("buyer_id") @db.Uuid
  buyer         User?           @relation("BuyerChats", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId      String?         @map("seller_id") @db.Uuid
  seller        User?           @relation("SellerChats", fields: [sellerId], references: [id], onDelete: SetNull)
  title         String?
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  closedAt      DateTime?       @map("closed_at")

  participants ChatParticipant[]
  messages     Message[]
  reports      ChatReport[]

  /// One conversation per pair of people — the rule the inbox is built on.
  ///
  /// The lookup in `startConversation` used to key on the product and the
  /// parcel as well, so the same two women accumulated a thread per subject
  /// and the inbox listed the same name four times. The key is now the pair,
  /// and this makes that a fact about the table rather than a habit of one
  /// method: two taps on «راسلي المتجر» arriving together can no longer both
  /// win, because the second create fails and is answered with the row the
  /// first one wrote.
  ///
  /// Postgres treats NULLs as distinct in a unique index, so rows where either
  /// side is null — a chat whose participant was deleted — are exempt, which
  /// is what we want: they are unreachable history, not live conversations.
  @@unique([buyerId, sellerId])
  @@index([productId])
  @@index([sellerOrderId])
  @@index([type, updatedAt])
  @@index([sellerId])
  @@map("chats")
}

model ChatParticipant {
  id                String               @id @default(uuid()) @db.Uuid
  chatId            String               @map("chat_id") @db.Uuid
