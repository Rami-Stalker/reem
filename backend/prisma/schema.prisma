model ProductReview {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String       @map("user_id") @db.Uuid
  user             User         @relation("CustomerProductReviews", fields: [userId], references: [id], onDelete: Cascade)
  orderId          String?      @map("order_id") @db.Uuid
  rating           Int
  title            String?
  body             String?
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  status           ReviewStatus @default(PENDING)
  helpfulCount     Int          @default(0) @map("helpful_count")

  /// The seller's answer, shown under the review. At most one, edited in
  /// place: a thread would imply a conversation nobody moderates.
  sellerReply     String?   @map("seller_reply")
  sellerRepliedAt DateTime? @map("seller_replied_at")

  // ── «تقييمات من بمقاسي» ──────────────────────────────────────────────

  /// How it fit, in her words: small, true, large. The one thing a return
  /// reason cannot say — `SIZE_ISSUE` has no direction.
  fit ReviewFit?

  /// The size she received, read from the delivered order's variant — never
  /// typed. A review saying "true to size" is only useful beside the size it
  /// was true of, and that size has to be the one that shipped.
  sizeBought String? @map("size_bought") @db.VarChar(16)

  /// Her height, rounded down to a 5 cm band (160 = 160–164), and her usual
  /// size, copied from her fit profile when she wrote the review and only if
  /// she agreed. **Stored for matching, never served**: no payload carries
  /// them, to anyone. They exist so «من بمقاسي» can find this review for women
  /// her size and the anonymous fit summary can count it. A snapshot, not a
  /// link, and never the exact height.
  heightBand Int?    @map("height_band")
  usualSize  String? @map("usual_size") @db.VarChar(8)

  /// Up to four photographs of the piece, uploads of purpose `review`.
  /// Public once the review is approved, and moderated with it.
  photoUrls String[] @default([]) @map("photo_urls")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  moderationLogs ReviewModerationLog[]

  /// One voice per customer per product.
  ///
  /// The old key included `orderId`, and Postgres treats NULLs as *distinct*
  /// in a unique index — so an unverified review, which carried no order,
  /// could be written any number of times. The service checked first, but a
  /// check followed by an insert is two moments and two concurrent requests
  /// both passed it. The database refuses the second one now.
  ///
  /// A customer who bought the same dress twice still gets one review of it,
  /// which is the honest reading: her opinion of the garment is one opinion.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("product_reviews")
}

model SellerReview {
  id               String       @id @default(uuid()) @db.Uuid
  sellerId         String       @map("seller_id") @db.Uuid
