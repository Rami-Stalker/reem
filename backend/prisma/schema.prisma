// Reem Shop — PostgreSQL schema (Prisma).
// All ids are UUIDs. JSON responses are snake_case (handled in serializers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  SELLER
  CUSTOMER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  CREATED
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethodType {
  VISA
  SHAM_CASH
  BEMO
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MediaType {
  image
  video
}

enum NotificationType {
  like
  comment
  follow
  message
  order
  payment
  post
  story
  promo
  coupon
  system
}

enum NotificationChannel {
