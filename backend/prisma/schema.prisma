enum SecurityEventType {
  GUEST_CREATED
  GUEST_MIGRATED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  SUSPICIOUS_LOGIN
  REFRESH_TOKEN_REUSE
  SESSION_REVOKED
  DEVICE_CREATED
  DEVICE_TRUSTED
  DEVICE_REVOKED
  AUTHZ_DENIED
  PASSWORD_CHANGED
  SELLER_VERIFICATION_SUBMITTED
  SELLER_VERIFICATION_REVIEWED
  /// An admin changed the OTP transport chain — the one table whose misuse
  /// reroutes every code on the platform.
  OTP_ROUTE_CHANGED
  /// An admin read plaintext one-time codes out of the ops console.
  OTP_CODE_REVEALED
  /// She opted into a password, or dropped it again.
  PASSWORD_ENABLED
  PASSWORD_DISABLED
  /// The account moved to a different number — the single most consequential
  /// edit in the product, since it redirects every future code.
  PHONE_CHANGED
  /// A password verified on a device the account has never signed in from.
  /// Not an error: the expected outcome, recorded because a run of them
  /// against many accounts is a credential-stuffing campaign.
  PASSWORD_NEW_DEVICE_BLOCKED
  /// Support-mediated recovery, one event per state transition.
  RECOVERY_CASE_OPENED
  RECOVERY_CASE_APPROVED
  RECOVERY_CASE_REJECTED
  RECOVERY_CASE_CANCELLED
  RECOVERY_CASE_COMPLETED
  /// Payouts held after a takeover-shaped event.
  PAYOUT_FROZEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A phone change is two challenges, not one, and this is the state between
/// them.
enum PhoneChangeStatus {
  /// Code sent to the number currently on the account.
  AWAITING_CURRENT
  /// Old number proved; code sent to the new one.
  AWAITING_NEW
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Support-mediated recovery, for the one case the self-service ladder cannot
/// reach: the SIM is gone.
///
/// Every transition is deliberate friction. `SUBMITTED` -> `UNDER_REVIEW` is a
/// human reading platform-held evidence; `AWAITING_SECOND_APPROVAL` is dual
/// control, because a single support account must never be able to hand an
/// account to anyone; `COOLING_OFF` is the 72 hours during which the real
/// owner — who still holds the number in every scenario but this one — can
/// kill the case from her phone.
enum AccountRecoveryStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_SECOND_APPROVAL
  COOLING_OFF
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

