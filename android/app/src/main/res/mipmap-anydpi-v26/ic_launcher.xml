<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, API 26+. The launcher masks the two layers to whatever shape
  the device uses — circle, squircle, teardrop — and parallaxes them apart, so
  the mark lives on the foreground and the rose ground on the background,
  never baked into one square. `mipmap-*/ic_launcher.png` remains for API 25
  and below, and for the Play Store's own listing.

  <monochrome> is the themed-icon silhouette Android 13+ tints with the user's
  wallpaper palette. Without it the launcher leaves this icon full-colour while
  every other icon on her home screen turns monochrome.

  Every layer here is regenerated by tools/icons/generate_app_icons.dart.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
