<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, API 26+. The launcher masks the layers to whatever shape the
  device uses — circle, squircle, teardrop. The artwork sits on the foreground
  (its middle 72dp is what shows; the margin repeats the art's edge so
  parallax never reveals a seam) over a flat ground in the art's own average
  colour. `mipmap-*/ic_launcher.png` remains for API 25 and below.

  There is no <monochrome> layer: the artwork is a detailed illustration with
  no single-colour silhouette, so on Android 13+ it stays full-colour.

  Every layer here is regenerated by tools/icons/generate_app_icons.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
