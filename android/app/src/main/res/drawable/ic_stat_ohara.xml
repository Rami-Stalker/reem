<?xml version="1.0" encoding="utf-8"?>
<!--
  The small icon Android draws in the status bar and beside a notification.

  White on transparent, and that is not a style choice. Android renders the
  small icon as a *silhouette*: every non-transparent pixel is repainted with
  the notification's accent colour, whatever its own colour was. Handing it the
  launcher icon — which is what most projects do, because `@mipmap/ic_launcher`
  is the obvious name — produces a solid white square on the lock screen of
  every phone. There is no warning; it simply looks broken.

  So this is a flat glyph with an alpha channel and nothing else. The rose it
  is tinted with comes from `notification_accent` in colors.xml, declared as
  the app-wide default in the manifest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
