<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Reem ships. Android 13 reads this to offer a per-app language
  in system Settings; without it the app is absent from that screen and a
  bilingual household has to change the whole phone to read the shop in Arabic.
  Arabic is first because it is the first language of the market.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar"/>
    <locale android:name="en"/>
</locale-config>
