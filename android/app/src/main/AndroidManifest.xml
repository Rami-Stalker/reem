<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Notifications, on Android 13 and later.

      A runtime permission rather than an install-time one since API 33: the
      app must ask, and a refusal is permanent — the system dialog never
      appears a second time. That is why the app does not ask at first launch;
      see `PushNotificationService.request`.

      On API 32 and earlier this permission does not exist and notifications
      are granted by default, so nothing here changes for those handsets.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      Three permissions `flutter_local_notifications` merges into this manifest
      that Reem must not ship, removed explicitly.

      Nothing in this app schedules a notification for a later time or needs to
      redraw one after a reboot — every notification Reem shows is drawn the
      moment a push arrives. Both alarm permissions oblige a publisher to
      justify them in writing to Google Play, and `RECEIVE_BOOT_COMPLETED`
      makes the app start at boot, which is a battery cost with nothing on the
      other side of it. This is also why the package was removed from
      pubspec.yaml once before; it is back because it now has a job, and the
      permissions it drags in do not.

      If a future feature ever does schedule a local notification, deleting one
      of these lines is how it gets its permission back — deliberately, rather
      than by accident.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove"/>

    <!--
      A camera is used for product photographs and stories, and is not
      required: `required="false"` keeps the app installable on a device
      without one, where she picks from the gallery instead.

      No CAMERA permission is declared on purpose. image_picker hands the job
      to the system camera app through ACTION_IMAGE_CAPTURE, which needs none —
      and declaring it would oblige the app to ask for a runtime permission it
      never uses.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!--
      Voice notes. Unlike the camera, this one *is* declared: recording happens
      inside the app rather than by handing the job to another one, so there is
      no system activity to borrow the permission from. `record` asks for it at
      the moment she first holds the button.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              Room invites. The app has always copied
              `reem://rooms/join/<slug>` to the clipboard with a message
              promising that whoever opens it can advise and vote — and no
              scheme was registered on either platform, so the one link Reem
              hands out opened nothing anywhere. The route behind it
              (`/rooms/join/:slug`) and the endpoint it calls both already
              existed; only this was missing.

              A custom scheme rather than an https App Link because verifying
              one needs `assetlinks.json` served from reem.shop carrying this
              build's signing fingerprint. That is a deployment step, not a
              code change; until it is done, this is what actually works.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="reem"/>
            </intent-filter>
        </activity>
        <!--
          What a push looks like when the app is not running.

          These three defaults are read by the Firebase Messaging SDK itself,
          in the native code that draws a notification arriving at a terminated
          app — where no Dart has run and nothing this project wrote gets a
          say. Without them Android falls back to the launcher icon, which it
          renders as a silhouette: a solid white square on the lock screen.

          The channel named here is the fallback for a message that names none.
          It must be one `notification_channels.dart` creates at startup, or
          Android 8+ discards the notification without a word.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_reem" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reem_system" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
