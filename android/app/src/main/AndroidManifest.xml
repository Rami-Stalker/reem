<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Notifications, on Android 13 and later.

      A runtime permission rather than an install-time one since API 33: the
      app must ask, and a refusal is permanent — the system dialog never
      appears a second time. That is why the app does not ask at first launch;
      see `PushNotificationService.request`.

      On API 32 and earlier this permission does not exist and notifications
      are granted by default, so nothing here changes for those handsets.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      Three permissions `flutter_local_notifications` merges into this manifest
      that Ohara must not ship, removed explicitly.

      Nothing in this app schedules a notification for a later time or needs to
      redraw one after a reboot — every notification Ohara shows is drawn the
      moment a push arrives. Both alarm permissions oblige a publisher to
      justify them in writing to Google Play, and `RECEIVE_BOOT_COMPLETED`
      makes the app start at boot, which is a battery cost with nothing on the
      other side of it. This is also why the package was removed from
      pubspec.yaml once before; it is back because it now has a job, and the
      permissions it drags in do not.

      If a future feature ever does schedule a local notification, deleting one
      of these lines is how it gets its permission back — deliberately, rather
      than by accident.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove"/>

    <!--
      A camera is used for product photographs and stories, and is not
      required: `required="false"` keeps the app installable on a device
      without one, where she picks from the gallery instead.

      No CAMERA permission is declared on purpose. image_picker hands the job
      to the system camera app through ACTION_IMAGE_CAPTURE, which needs none —
      and declaring it would oblige the app to ask for a runtime permission it
      never uses.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!--
      Voice notes. Unlike the camera, this one *is* declared: recording happens
      inside the app rather than by handing the job to another one, so there is
      no system activity to borrow the permission from. `record` asks for it at
      the moment she first holds the button.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!--
      The location picker's «موقعي الحالي» button. Asked for only when she taps
      it, while the app is open — never in the background. Coarse is declared
      too because Android 12+ lets her grant only an approximate position, and
      the picker still works with one (she nudges the pin the last few metres).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              Deep links are routed by the Flutter engine rather than by
              MainActivity, which is what lets GoRouter's own redirect decide
              where an incoming path goes. Without this the engine ignores the
              VIEW intents below and every link merely launches the app on its
              home screen.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />

            <!--
              The custom scheme. Still here, and still load-bearing: on Android
              WhatsApp opens links in an embedded browser, and an embedded
              browser never triggers App Link verification. The landing page's
              «افتحي في تطبيق أوهارا» button uses this, and for a large share of
              real taps it is the only thing that works.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="reem"/>
            </intent-filter>

            <!--
              Android App Links — https links that open the app directly, with
              no disambiguation dialog.

              `autoVerify` makes Android fetch
              `https://<host>/.well-known/assetlinks.json` at install time and
              check that it names this package and this build's signing
              certificate. The API serves that file (see
              `backend/src/modules/links`), generated from
              ANDROID_SHA256_CERT_FINGERPRINTS — until that variable is set the
              file is an empty array, verification simply does not happen, and
              these links open the web page instead. Nothing breaks either way.

              The host must match `SHARE_BASE_URL` in the Flutter build and
              `SHARE_PUBLIC_ORIGIN` on the API. Both hosts are listed so that
              moving to the custom domain is a deploy rather than a release:
              links already in circulation on the onrender.com host keep
              opening the app.

              `pathPrefix` is deliberately narrow. `/invite/` is NOT here: an
              invitation is sent to somebody who does not have Ohara, so having
              the app swallow it would hide the download button from the one
              person it was written for.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="reem-api.onrender.com"/>
                <data android:scheme="https" android:host="reem.shop"/>
                <data android:scheme="https" android:host="www.reem.shop"/>
                <data android:pathPrefix="/product/"/>
                <data android:pathPrefix="/p/"/>
                <data android:pathPrefix="/u/"/>
                <data android:pathPrefix="/user/"/>
                <data android:pathPrefix="/content/"/>
                <data android:pathPrefix="/collection/"/>
                <data android:pathPrefix="/salons/"/>
                <data android:pathPrefix="/rooms/join/"/>
            </intent-filter>
        </activity>
        <!--
          What a push looks like when the app is not running.

          These three defaults are read by the Firebase Messaging SDK itself,
          in the native code that draws a notification arriving at a terminated
          app — where no Dart has run and nothing this project wrote gets a
          say. Without them Android falls back to the launcher icon, which it
          renders as a silhouette: a solid white square on the lock screen.

          The channel named here is the fallback for a message that names none.
          It must be one `notification_channels.dart` creates at startup, or
          Android 8+ discards the notification without a word.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ohara" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reem_system" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
