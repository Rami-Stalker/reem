# ---------------------------------------------------------------------------
# Reem — repository ignore rules
#
# Layout: a Flutter client at the repository root and a NestJS API in
# `backend/`. Rules are grouped by the tool that produces the artifact, and
# anchored with a leading `/` wherever a pattern must match the root only.
# ---------------------------------------------------------------------------

# --- Editors & OS ----------------------------------------------------------
.DS_Store
.atom/
.history
.idea/
.qodo/
.svn/
.swiftpm/
.vscode/
*.iml
*.ipr
*.iws
*.swp

# Claude Code: `launch.json` is shared with the team, machine-local
# settings and transcripts are not.
.claude/settings.local.json
.claude/local/

# --- Logs & scratch --------------------------------------------------------
*.log
*.pyc
migrate_working_dir/

# --- Dart / Flutter --------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication & obfuscation output
app.*.symbols
app.*.map.json

# --- Android ---------------------------------------------------------------
/android/.gradle/
/android/build/
/android/app/build/
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties
/android/key.properties
*.jks
*.keystore
*.p12

# --- iOS / macOS -----------------------------------------------------------
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/macos/Pods/

# --- Node -----------------------------------------------------------------
# Anchored so an accidental `npm install` at the repository root is caught,
# not just the backend's own tree.
node_modules/
/node_modules/
npm-debug.log*
yarn-error.log*

# --- Backend (NestJS) ------------------------------------------------------
backend/dist/
backend/.env
!backend/.env.example
backend/prisma/dev.db
backend/prisma/dev.db-journal

# Uploaded media. User content, not source -- and `private/` holds photographs
# of identity documents, which must never reach a repository.
backend/storage/

# --- Test fixtures ---------------------------------------------------------
# Contract fixtures are captured from a running API; keep them, they are the
# only thing proving the client and server agree.
!test/contract/*.json

# --- Firebase (push notifications) -----------------------------------------
# Each names one specific Firebase project, and local, staging and production
# are three different ones — so these belong to a machine or a build pipeline
# rather than to the repository. The Android build applies the google-services
# plugin only when the file is present; see android/app/build.gradle.kts.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# The API's half of the same credential. A service-account key is a private
# key that can send a notification to every customer.
**/firebase-service-account*.json
