<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ohara</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ohara</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  App Transport Security is left at its default: TLS only, no exceptions.

	  This used to carry NSAllowsLocalNetworking with a usage string that said,
	  in as many words, that the app talks to a development API on the local
	  network. That is a development convenience shipped in a production
	  binary: it triggers iOS 14's local-network permission prompt on first
	  launch — a customer being asked to let a shop scan her home network — and
	  it is exactly the kind of string an App Review notes. A debug build that
	  needs to reach a laptop can add the exception back in a Debug-only plist;
	  the release binary talks to https://api.reem.shop and nothing else.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>لالتقاط صور لمنتجاتكِ وقصصكِ مباشرةً من التطبيق.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>لتسجيل ملاحظة صوتية وإرسالها في المحادثة.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>لاختيار صور من معرضكِ وإضافتها إلى منتجاتكِ وقصصكِ.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
	  Portrait only on iPhone. Ohara's hundred-odd screens are single-column
	  pages — a feed, a product, a checkout — and there is no landscape layout
	  behind them: rotating produced a stretched column with empty gutters.
	  The iPad list below stays complete, because a tablet held sideways is the
	  normal way to hold a tablet and the layouts cap their content width.
	  AppSystemChrome applies the same rule at runtime from the window's
	  shortest side, so a foldable is judged by its size rather than its badge.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  The languages the App Store lists this app under. Without it the listing
	  claims English only, while the app opens in Arabic for the market it was
	  built for.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
	<!--
	  Export compliance. Ohara uses HTTPS and the platform keychain and nothing
	  else — no proprietary or non-standard cryptography — which is the exempt
	  case. Declaring it here answers the question App Store Connect otherwise
	  asks by hand on every single upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  A phone number opened from an order (Q55, «يتصل بالزبونة بضغطة») and a
	  delivery address opened in Maps. iOS answers `canLaunchUrl` with false for
	  any scheme not listed here, so without this the call and map buttons
	  silently did nothing on an iPhone while working on Android.
	-->
	<!--
	  Deep links are routed by the Flutter engine, so an incoming Universal Link
	  or `reem://` URL reaches GoRouter's own redirect and is resolved by
	  `ShareLinks.routeFor` — the same function the Android side uses. Without
	  this key iOS hands the URL to the AppDelegate, nothing listens, and the
	  link merely launches the app on its home screen.
	-->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<!--
	  The custom scheme — `reem://product-details?id=…`, `reem://rooms/join/<slug>`.
	  Kept alongside the Universal Links in Runner.entitlements rather than
	  replaced by them: it is what the landing page's «افتحي في تطبيق أوهارا»
	  button opens, which is the path taken whenever a link arrives somewhere
	  Universal Links do not fire — a pasted URL, an unverified association, a
	  redirect chain.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>shop.reem.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reem</string>
			</array>
		</dict>
	</array>
	<!--
	  Push notifications.

	  `remote-notification` lets iOS hand a push to the app while it is in the
	  background — which is what makes the badge on the app icon correct at the
	  moment she looks at her home screen, rather than at the moment she next
	  opens Ohara.

	  Note what is deliberately NOT here: `fetch`. Background fetch is a
	  different capability, App Review asks what it is for, and Ohara has no
	  answer — nothing in this app needs to wake up on a timer.

	  The `aps-environment` entitlement in Runner.entitlements is the other
	  half of this, and the one the build actually fails without.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>https</string>
		<string>maps</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
