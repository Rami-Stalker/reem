# Ohara — CocoaPods configuration.
#
# This file was missing from the repository. Flutter writes a default one on
# the first `pod install`, which meant the minimum iOS version and the build
# settings applied to every pod were whatever the machine that happened to run
# the build produced — and were never reviewed, because they were never in the
# tree. They are now, and they match what the Xcode project declares.

# 13.0 is this Flutter SDK's floor and the value IPHONEOS_DEPLOYMENT_TARGET
# carries in Runner.xcodeproj. Naming it here builds every pod against the same
# one instead of letting each inherit its own, older default and warn on every
# build.
platform :ios, '13.0'

# CocoaPods phones home on every install; this only slows the build down.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # A pod that ships an older default would otherwise drag a deployment
      # target warning — and occasionally a real build failure — into every
      # archive. Pinning them all to the app's own floor is the fix Flutter's
      # own docs give.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
